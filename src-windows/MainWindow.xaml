<Window x:Class="Mihomo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Mihomo.Desktop.Controls"
        xmlns:services="clr-namespace:Mihomo.Desktop.Services"
        Title="Mihomo Optimized" Width="1240" Height="820" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei" FontSize="14"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="Assets/icon.ico" AutomationProperties.AutomationId="MainWindow"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDragLeave="OnDragLeave" PreviewDrop="OnDrop">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" controls:ShellVisuals.Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtleHoverBrush}"/></Trigger>
          <Trigger Property="Tag" Value="hover"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtleHoverBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtlePressedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Trigger>
          <Trigger Property="Tag" Value="pressed"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtlePressedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" controls:ShellVisuals.Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="#E6C42B1C"/><Setter Property="Foreground" Value="#B3FFFFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="36"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" CornerRadius="4" controls:ShellVisuals.Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtleHoverBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtlePressedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TitleSearch" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
      <Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid><Border x:Name="Frame" controls:ShellVisuals.Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
          <Border x:Name="Underline" Height="1" Margin="1,0,1,0" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="{DynamicResource ControlStrongBrush}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Underline" Property="Height" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ShellNavItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
      <Setter Property="controls:ShellVisuals.TrackPress" Value="True"/>
      <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="4,0,4,4"/><Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Frame" CornerRadius="4" Padding="{TemplateBinding Padding}" controls:ShellVisuals.Background="{TemplateBinding Background}">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtleHoverBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtleHoverBrush}"/></Trigger>
          <Trigger Property="controls:ShellVisuals.Pressed" Value="True"><Setter TargetName="Frame" Property="controls:ShellVisuals.Background" Value="{DynamicResource SubtlePressedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="ClientArea" Background="{DynamicResource AppBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" AutomationProperties.AutomationId="NativeTitleBar">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="4,0,4,0">
        <Button x:Name="BackButton" Style="{StaticResource TitleButton}" Click="GoBack" IsEnabled="False"
                ToolTip="{services:Tr 返回}" AutomationProperties.Name="{services:Tr 返回}" AutomationProperties.AutomationId="TitleBarBack"><controls:FluentIcon Kind="arrow-left"/></Button>
        <Button x:Name="NavigationToggle" Style="{StaticResource TitleButton}" Click="ToggleNavigation" Margin="2,0,0,0"
                ToolTip="{services:Tr 展开或收起导航}" AutomationProperties.Name="{services:Tr 展开或收起导航}" AutomationProperties.AutomationId="NavigationToggle"><controls:FluentIcon Kind="navigation"/></Button>
        <StackPanel x:Name="TitleIdentity" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0" IsHitTestVisible="False">
          <Image x:Name="TitleLogo" Source="Assets/logo.png" Width="16" Height="16"/>
          <TextBlock x:Name="TitleName" Text="Mihomo Optimized" FontSize="12" LineHeight="16" Margin="12,0,0,0" VerticalAlignment="Center" controls:ShellVisuals.Duration="167"/>
          <TextBlock x:Name="TitleSubtitle" FontSize="12" LineHeight="16" Margin="12,0,0,0" VerticalAlignment="Center"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}"
                     Visibility="Collapsed" controls:ShellVisuals.Duration="167"/>
        </StackPanel>
      </StackPanel>
      <controls:GlobalSearchBox x:Name="SearchButton" Grid.Column="1" MaxWidth="380" Height="32" Margin="12,0"
                               shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
        <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="{services:Tr 最小化}" AutomationProperties.Name="{services:Tr 最小化}" AutomationProperties.AutomationId="TitleBarMinimize"><controls:FluentIcon Kind="minimize"/></Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeWindow" ToolTip="{services:Tr 最大化}" AutomationProperties.Name="{services:Tr 最大化}" AutomationProperties.AutomationId="TitleBarMaximize"><controls:FluentIcon x:Name="MaximizeIcon" Kind="maximize"/></Button>
        <Button Style="{StaticResource CaptionCloseButton}" Click="CloseToTray" ToolTip="{services:Tr 关闭}" AutomationProperties.Name="{services:Tr 关闭}" AutomationProperties.AutomationId="TitleBarClose"><controls:FluentIcon Kind="dismiss"/></Button>
      </StackPanel>
    </Grid>
    <Grid x:Name="ContentLayout" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="NavigationDock" Width="280" ClipToBounds="True">
        <Grid x:Name="NavigationPane" Width="280" Margin="0,4,0,6" ClipToBounds="True">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button x:Name="CoreCardButton" Margin="4,2,4,8" Height="56" Padding="8" HorizontalContentAlignment="Stretch" Click="OpenCoreMenu" AutomationProperties.AutomationId="CoreCard" AutomationProperties.Name="{services:Tr 本地内核}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid x:Name="CoreAvatar" Width="40" Height="40" VerticalAlignment="Center">
                <Border x:Name="CoreAvatarBackground" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeBrush}" controls:ShellVisuals.Duration="250" controls:ShellVisuals.Background="{DynamicResource ControlAltBrush}"><Grid><controls:FluentIcon x:Name="CoreGlyph" Kind="power" Width="20" Height="20"/><Image x:Name="CoreImage" Source="{StaticResource ColorIcon.globe-shield.24}" Width="24" Height="24" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border>
                <Border x:Name="CoreStatusDot" Width="16" Height="16" Margin="0,0,-2,-2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource DialogBottomBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" controls:ShellVisuals.Duration="250" controls:ShellVisuals.Background="{DynamicResource TextTertiaryBrush}"/>
                <controls:FluentProgressRing x:Name="CoreProgress" Width="48" Height="48" Margin="-4"/>
              </Grid>
              <StackPanel x:Name="CoreText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="PhaseText" Text="{services:Tr 正在连接…}" FontWeight="SemiBold" FontSize="14" LineHeight="20" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="CorePhase"/>
                <TextBlock x:Name="VersionText" FontSize="12" LineHeight="16" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Button>
          <ListBox x:Name="NavigationList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ShellNavItem}"
                   SelectionChanged="NavigationChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.AutomationId="Navigation">
            <ListBoxItem Tag="home" AutomationProperties.AutomationId="NavHome"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ColorIcon.home.20}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{services:Tr 主页}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            <ListBoxItem Tag="proxies" AutomationProperties.AutomationId="NavProxies"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ColorIcon.globe-shield.20}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{services:Tr 代理}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            <ListBoxItem Tag="connections" AutomationProperties.AutomationId="NavConnections"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ColorIcon.data-line.20}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{services:Tr 连接}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            <ListBoxItem Tag="dns" AutomationProperties.AutomationId="NavDns"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ColorIcon.database.20}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="DNS" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            <ListBoxItem Tag="rules" AutomationProperties.AutomationId="NavRules"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ColorIcon.text-bullet-list-square.20}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{services:Tr 规则}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            <ListBoxItem Tag="logs" AutomationProperties.AutomationId="NavLogs"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ColorIcon.notebook.20}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{services:Tr 日志}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
          </ListBox>
          <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="0,6,0,0" Margin="0,12,0,0">
            <ListBox x:Name="SettingsNavigation" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ShellNavItem}" SelectionChanged="NavigationChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBoxItem Tag="profiles" Margin="4,0,4,4" AutomationProperties.AutomationId="NavProfiles"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ColorIcon.document-text.20}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock x:Name="ProfilesLabel" Text="{services:Tr 配置}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
              <ListBoxItem Tag="settings" Margin="4,0" AutomationProperties.AutomationId="NavSettings"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="{StaticResource ColorIcon.settings.20}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock x:Name="SettingsLabel" Grid.Column="1" Text="{services:Tr 设置}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <Border x:Name="UpdateBadge" Grid.Column="2" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
              </Grid></ListBoxItem>
            </ListBox>
          </Border>
          <Canvas x:Name="SelectionCanvas" Grid.RowSpan="3" IsHitTestVisible="False"><Border x:Name="SelectionPill" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" Canvas.Left="4" Visibility="Collapsed"/></Canvas>
        </Grid>
      </Grid>
      <Border x:Name="MainContentBorder" Grid.Column="1" CornerRadius="8,0,0,0" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource LayerStrokeBrush}" BorderThickness="1,1,0,0" ClipToBounds="True">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <ContentControl x:Name="UpdateNoticeSlot" HorizontalContentAlignment="Stretch"/>
          <ContentControl x:Name="PageContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          <Grid x:Name="ContentPageOverlayHost" Grid.RowSpan="2" Panel.ZIndex="5"/>
        </Grid>
      </Border>
      <Border x:Name="NavigationScrim" Grid.ColumnSpan="2" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="CloseNavigationOverlay" Panel.ZIndex="5"/>
      <controls:RoundedContentBorder x:Name="OverlayPaneHost" Grid.ColumnSpan="2" Width="280" HorizontalAlignment="Left" CornerRadius="0,8,8,0" Background="Transparent" BorderBrush="{DynamicResource AcrylicStrokeBrush}" BorderThickness="0,0,1,0" Visibility="Collapsed" Panel.ZIndex="6" ClipToBounds="False">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.14"/></Border.Effect>
      </controls:RoundedContentBorder>
      <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Margin="16" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><controls:FluentIcon Kind="arrow-import" Width="36" Height="36" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <TextBlock Text="{services:Tr 松开以导入配置}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="24,0"/>
          <TextBlock Text="{services:Tr 支持 .yaml / .yml，导入前会先预览}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="16,8,16,0"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="PageOverlayHost" Grid.RowSpan="2" Panel.ZIndex="15" ClipToBounds="True"/>
    <Canvas x:Name="ConnectedOverlay" Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="20"/>
    <!-- A sibling of every sampled backdrop layer. Empty space stays pointer-transparent. -->
    <Canvas x:Name="SearchOverlayHost" Grid.RowSpan="2" Panel.ZIndex="70" Background="{x:Null}"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
  </Grid>
</Window>
