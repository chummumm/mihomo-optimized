<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>mihomo-optimized</AssemblyName>
    <RootNamespace>Mihomo.Desktop</RootNamespace>
    <Version>0.2.4</Version>
    <AssemblyVersion>0.2.4.0</AssemblyVersion>
    <FileVersion>0.2.4.0</FileVersion>
    <Product>Mihomo Optimized</Product>
    <Description>Mihomo Optimized native Windows client</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../src-tauri/icons/icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../src-tauri/icons/icon.ico" Link="Assets/icon.ico" />
    <Resource Include="../src/assets/logo.png" Link="Assets/logo.png" />
  </ItemGroup>
</Project>
