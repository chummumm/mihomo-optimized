+            if (event.key === 'Escape' && open[open.length - 1] === entry) onCloseRef.current()
+        }
+        document.addEventListener('keydown', keydown)
+        return () => {
+            open.splice(open.indexOf(entry), 1)
+            notify()
+            if (open.length === 0) for (const element of blocked) element.inert = false
+            document.removeEventListener('keydown', keydown)
+        }
+    }, [show])
+
+    // Always mounted, like ContentDialog: the page content is the caller's to
+    // unmount, so closing never waits for an exit animation to release it.
+    return createPortal(
+        <motion.section
+            className={classnames('subpage', { 'is-full': phone, 'is-closed': !show }, className)}
+            style={{ ...rect, ...style }}
+            aria-label={title}
+            aria-hidden={!show}
+            initial={false}
+            animate={show
+                ? { opacity: [0, 1], scale: [0.94, 1] }
+                : { opacity: 0, scale: 0.98 }}
+            transition={show ? { duration: 0.3, ease: [0, 0, 0, 1] } : { duration: 0.083, ease: [1, 0, 1, 1] }}
+            ref={sectionRef}
+        >
+            {show && <>
+                <header className="subpage-header">
+                    <button type="button" className="titlebar-button subpage-back" aria-label={t('back')} title={t('back')} onClick={() => onCloseRef.current()}>
+                        <Icon type="arrow-left" size={16} />
+                    </button>
+                    <nav className="subpage-crumbs" aria-label={t('back')}>
+                        <button type="button" className="subpage-crumb" onClick={() => onCloseRef.current()}>{parent}</button>
+                        <Icon type="chevron-right" size={12} className="subpage-crumb-sep" />
+                        <h1 className="subpage-title">{title}</h1>
+                    </nav>
+                    {aside != null && <div className="subpage-aside">{aside}</div>}
+                </header>
+                <div className={classnames('subpage-body', bodyClassName)}>{children}</div>
+            </>}
+        </motion.section>,
+        document.body,
+    )
+}
