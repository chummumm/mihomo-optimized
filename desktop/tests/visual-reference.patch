+// Settings the title-bar search can jump to. Each id is the element the page
+// scrolls to and highlights; labels come from the page's own strings.
+export interface SettingTarget {
+    id: string
+    namespace: 'Settings' | 'Desktop' | 'Profiles'
+    label: string
+    keywords: string
+    page?: string
+    desktopOnly?: boolean
+    webOnly?: boolean
+}
+
+export const SETTING_TARGETS: SettingTarget[] = [
+    { id: 'set-theme', namespace: 'Settings', label: 'labels.theme', keywords: 'theme dark light 主题 深色 浅色' },
+    { id: 'set-language', namespace: 'Settings', label: 'labels.language', keywords: 'language 语言 english 中文' },
+    { id: 'set-autostart', namespace: 'Settings', label: 'labels.startAtLogin', keywords: 'autostart login 开机 自启' },
+    { id: 'set-system-proxy', namespace: 'Settings', label: 'labels.setAsSystemProxy', keywords: 'system proxy 系统代理' },
+    { id: 'set-mode', namespace: 'Settings', label: 'labels.proxyMode', keywords: 'mode rule global direct 模式' },
+    { id: 'set-lan', namespace: 'Settings', label: 'labels.allowConnectFromLan', keywords: 'lan allow-lan 局域网' },
+    { id: 'set-ports', namespace: 'Settings', label: 'labels.mixedProxyPort', keywords: 'port mixed http socks 端口' },
+    { id: 'set-probe', namespace: 'Settings', label: 'labels.probeURL', keywords: 'probe url latency 测速' },
+    { id: 'set-tun', namespace: 'Desktop', label: 'tun', keywords: 'tun 虚拟网卡', desktopOnly: true },
+    { id: 'set-service', namespace: 'Desktop', label: 'service', keywords: 'service tun 服务 管理员', desktopOnly: true },
+    { id: 'set-controller', namespace: 'Settings', label: 'labels.externalController', keywords: 'controller host secret 控制器', webOnly: true },
+    { id: 'set-update', namespace: 'Settings', label: 'sections.update', keywords: 'update kernel dashboard 更新 内核 版本', webOnly: true },
+    { id: 'desktop-app-update', namespace: 'Desktop', label: 'appUpdate', keywords: 'update version 更新 版本', desktopOnly: true },
+    { id: 'set-resources', namespace: 'Profiles', label: 'resources', keywords: 'geo geoip geosite rule provider 规则集 资源', page: '/profiles' },
+]
diff --git a/src/containers/Shell/shell.css b/src/containers/Shell/shell.css
