-    max-width: 920px;
-    margin: 0;
+    max-width: 1000px;
+}
+
+.settings-section {
+    scroll-margin: 96px;
 }
 
-.settings-section + .settings-section {
-    margin-top: var(--sp-6);
+.settings-section + .settings-section,
+.profile-current + .settings-section {
+    margin-top: 28px;
+}
+
+.settings-section-head {
