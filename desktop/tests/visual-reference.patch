--- /dev/null
+++ b/src/containers/Home/index.tsx
@@ -0,0 +1,300 @@
+import classnames from 'classnames'
+import { useAtomValue } from 'jotai'
+import { useEffect, useMemo, useRef } from 'react'
+import { flushSync } from 'react-dom'
+import { useLocation, useNavigate } from 'react-router-dom'
+
+import { Button, ButtonSelect, Card, Header, Icon, ProgressRing, StaticBytes, delayStatus, error as toastError } from '@components'
+import { formatTraffic } from '@lib/helper'
+import { jsBridge } from '@lib/jsBridge'
+import { proxyGroupMapping, proxyMapping, useClashXData, useClient, useConnectionStreamReader, useGeneral, useI18n, useProxy, useVersion } from '@stores'
+
+import { askInstallService } from '../../platform/DesktopUI'
+import { desktopAction, isDesktop, useDesktop } from '../../platform/desktop'
+import { desktopError } from '../../platform/model'
+import { ThroughputChart } from '../Connections/Throughput'
+import { useConnections } from '../Connections/store'
+import { resolveProxyExit } from '../Proxies/resolve'
+import './style.css'
+
+type TileKey = 'systemProxy' | 'tun' | 'lan' | 'autostart'
+
+function useViewTransition () {
+    // Connected animation: the group's icon and name fly from Home into its
+    // header on the Proxies page. Browsers without view transitions just navigate.
+    return (update: () => void) => {
+        const doc = document as Document & { startViewTransition?: (callback: () => void) => unknown }
+        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
+        if (typeof doc.startViewTransition !== 'function' || still) { update(); return }
+        doc.startViewTransition(() => { flushSync(update) })
+    }
+}
+
+export default function Home () {
+    const { translation } = useI18n()
+    const { t } = translation('Home')
+    const { t: shell } = translation('Shell')
+    const { t: td } = translation('Desktop')
+    const navigate = useNavigate()
+    const location = useLocation()
+    const desktop = useDesktop()
+    const client = useClient()
+    const { general, update: refreshGeneral } = useGeneral()
+    const { version } = useVersion()
+    const { data: clashX, update: refreshClashX } = useClashXData()
+    const { groups } = useProxy()
+    const groupMap = useAtomValue(proxyGroupMapping)
+    const nodes = useAtomValue(proxyMapping)
+    const transition = useViewTransition()
+
+    const status = desktop.status
+    const phase = isDesktop() ? status?.phase ?? (desktop.ready ? 'error' : 'starting') : (version ? 'running' : 'stopped')
+    const running = phase === 'running'
+    const busy = !!desktop.busy || phase === 'starting' || phase === 'stopping'
+    const reader = useConnectionStreamReader(running)
+    const { connections, traffic, rate, samples } = useConnections(reader)
+    const sampleRef = useRef(samples)
+    sampleRef.current = samples
+
+    const active = useMemo(() => connections.filter(connection => connection.completed !== true), [connections])
+    const processCount = useMemo(() => new Set(active.map(connection => connection.metadata.processPath || connection.metadata.sourceIP)).size, [active])
+
+    function run (command: string, args?: Record<string, unknown>) {
+        void desktopAction(command, args).catch(reason => { toastError(desktopError(reason).message) })
+    }
+
+    function toggleTun () {
+        if (!status) return
+        if (!status.tun && !status.service?.installed) { askInstallService(true); return }
+        run('desktop_set_tun', { enabled: !status.tun })
+    }
+
+    // Search can ask Home to flip TUN, which may need the service dialog first.
+    const tunRequest = (location.state as { toggleTun?: boolean } | null)?.toggleTun
+    useEffect(() => {
+        if (tunRequest) toggleTun()
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [tunRequest, location.key])
+
+    async function setMode (mode: string) {
+        try {
+            await client.updateConfig({ mode })
+            await refreshGeneral()
+        } catch (reason) { toastError(isDesktop() ? desktopError(reason).message : td('operationFailed')) }
+    }
+
+    async function toggleLan () {
+        try {
+            await client.updateConfig({ 'allow-lan': !general.allowLan })
+            await refreshGeneral()
+        } catch (reason) { toastError(isDesktop() ? desktopError(reason).message : td('operationFailed')) }
+    }
+
+    const mainGroup = groups.find(group => group.type === 'Selector') ?? groups[0]
+    const mainExit = mainGroup ? resolveProxyExit(mainGroup.now, groupMap) : undefined
+    const mainDelay = mainExit ? nodes.get(mainExit)?.history?.slice(-1)[0]?.delay : undefined
+    const modeName = general.mode ? shell(`modes.${general.mode}` as 'modes.rule') : ''
+
+    const title = {
+        running: isDesktop() ? t('connected') : t('online'),
+        starting: t('starting'),
+        stopping: t('stopping'),
+        stopped: isDesktop() ? t('notRunning') : t('offline'),
+        error: t('error'),
+    }[phase]
+    const subtitle = running
+        ? [modeName, mainGroup && mainExit ? `${mainGroup.name} → ${mainExit}${mainDelay ? ` · ${mainDelay} ms` : ''}` : ''].filter(Boolean).join(' · ')
+        : phase === 'starting'
+            ? t('startingHint')
+            : phase === 'stopping'
+                ? t('stoppingHint')
+                : isDesktop() ? `${t('savedConfig')}${status?.configPath ? ` · ${status.configPath.split(/[\\/]/).pop()}` : ''}` : t('offline')
+
+    const port = general.mixedPort || general.port || 7890
+    const tiles: Array<{ key: TileKey, icon: string, on: boolean, state: string, more?: string, disabled: boolean, busy?: boolean, onToggle: () => void }> = []
+    if (isDesktop() || clashX?.isClashX) {
+        const systemProxy = isDesktop() ? status?.systemProxy ?? false : clashX?.systemProxy ?? false
+        tiles.push({
+            key: 'systemProxy',
+            icon: 'nav-proxies',
+            on: systemProxy,
+            state: systemProxy ? (running ? t('tiles.port').replace('{p}', String(port)) : t('tiles.afterStart')) : t('tiles.off'),
+            more: 'set-system-proxy',
+            disabled: isDesktop() ? !!desktop.busy || !status?.capabilities.systemProxy : false,
+            busy: desktop.busy === 'desktop_set_system_proxy',
+            onToggle: () => {
+                if (isDesktop()) run('desktop_set_system_proxy', { enabled: !systemProxy })
+                else void Promise.resolve(jsBridge?.setSystemProxy(!systemProxy)).then(() => refreshClashX())
+            },
+        })
+    }
+    if (isDesktop()) {
+        const tun = status?.tun ?? false
+        tiles.push({
+            key: 'tun',
+            icon: 'shield-lock',
+            on: tun,
+            state: tun ? (running ? t('tiles.on') : t('tiles.afterStart')) : status?.service?.installed ? t('tiles.off') : t('tiles.needService'),
+            more: 'set-tun',
+            disabled: busy || !status?.capabilities.tun,
+            busy: desktop.busy === 'desktop_set_tun',
+            onToggle: toggleTun,
+        })
+    }
+    tiles.push({
+        key: 'lan',
+        icon: 'wifi',
+        on: !!general.allowLan,
+        state: general.allowLan ? t('tiles.lanOn').replace('{p}', String(port)) : t('tiles.lanOff'),
+        more: 'set-lan',
+        disabled: !running,
+        onToggle: () => { void toggleLan() },
+    })
+    if (isDesktop()) {
+        const autostart = status?.autostart ?? false
+        tiles.push({
+            key: 'autostart',
+            icon: 'power',
+            on: autostart,
+            state: autostart ? t('tiles.autostartOn') : t('tiles.off'),
+            disabled: !!desktop.busy || !status?.capabilities.autostart,
+            busy: desktop.busy === 'desktop_set_autostart',
+            onToggle: () => run('desktop_set_autostart', { enabled: !autostart }),
+        })
+    }
+
+    const exits = groups.filter(group => group.type === 'Selector' || group.type === 'URLTest' || group.type === 'Fallback').slice(0, 4)
+    const modeOptions = [
+        { label: shell('modeShort.rule'), value: 'rule' },
+        { label: shell('modeShort.global'), value: 'global' },
+        { label: shell('modeShort.direct'), value: 'direct' },
+    ]
+
+    function openGroup (name: string, element: HTMLElement | null) {
+        if (element) element.style.setProperty('view-transition-name', 'exit-group')
+        transition(() => {
+            if (element) element.style.removeProperty('view-transition-name')
+            navigate('/proxies', { state: { focusGroup: name, connected: true } })
+        })
+    }
+
+    return (
+        <div className="page home-page">
+            <Header title={t('title')} />
+
+            <Card className="home-hero" data-phase={phase}>
+                <div className="home-hero-main">
+                    <div className="home-hero-glyph">
+                        <span className="home-hero-ring" aria-hidden="true" />
+                        {busy && <ProgressRing size={76} className="home-hero-progress" />}
+                        <Icon type={running ? 'globe-shield' : phase === 'error' ? 'warning' : 'globe-shield'} size={28} filled={running} />
+                    </div>
+                    <div className="home-hero-text">
+                        <h2>{title}</h2>
+                        <p title={subtitle}>{subtitle}</p>
+                    </div>
+                    {isDesktop() && <div className="home-hero-actions">
+                        {running
+                            ? <>
+                                <Button icon="stop" disabled={busy} loading={desktop.busy === 'desktop_stop'} onClick={() => run('desktop_stop')}>{td('stop')}</Button>
+                                <Button icon="update" ariaLabel={td('restart')} title={td('restart')} disabled={busy} loading={desktop.busy === 'desktop_restart'} onClick={() => run('desktop_restart')} />
+                            </>
+                            : <Button type="primary" icon="play" disabled={busy || !status} loading={desktop.busy === 'desktop_start'} onClick={() => run('desktop_start')}>{td('start')}</Button>}
+                    </div>}
+                </div>
+                {isDesktop() && status?.lastError && <p className="desktop-error home-hero-error" role="alert">{status.lastError}</p>}
+                <div className="home-hero-foot">
+                    <div className="home-hero-mode">
+                        <span>{t('mode')}</span>
+                        <ButtonSelect label={t('mode')} disabled={!running} options={modeOptions} value={general.mode} onSelect={value => { void setMode(value) }} />
+                    </div>
+                    <dl className="home-hero-facts">
+                        <div><dt>{t('core')}</dt><dd className="reading">{(isDesktop() ? status?.coreVersion : version)?.replace('mihomo-optimized-', '') || '—'}</dd></div>
+                        <div><dt>{t('localProxy')}</dt><dd className="reading">127.0.0.1:{port}</dd></div>
+                    </dl>
+                </div>
+            </Card>
+
+            {tiles.length > 0 && <div className="home-tiles" role="group" aria-label={t('title')}>
+                {tiles.map(tile => (
+                    <div key={tile.key} className={classnames('home-tile', { 'is-on': tile.on, 'is-busy': tile.busy })} data-tile={tile.key}>
+                        <button type="button" className="home-tile-main" aria-pressed={tile.on} disabled={tile.disabled} onClick={tile.onToggle}>
+                            {tile.busy ? <ProgressRing size={20} /> : <Icon type={tile.icon} size={20} filled={tile.on} />}
+                            <span className="home-tile-label">
+                                <b>{t(`tiles.${tile.key}`)}</b>
+                                <span>{tile.state}</span>
+                            </span>
+                        </button>
+                        {tile.more && <button
+                            type="button"
+                            className="home-tile-more"
+                            aria-label={t('tiles.more').replace('{name}', t(`tiles.${tile.key}`))}
+                            title={t('tiles.more').replace('{name}', t(`tiles.${tile.key}`))}
+                            onClick={() => navigate('/settings', { state: { focus: tile.more } })}
+                        >
+                            <Icon type="chevron-right" size={12} />
+                        </button>}
+                    </div>
+                ))}
+            </div>}
+
+            <div className="home-grid">
+                <Card className="home-throughput">
+                    <div className="home-card-head">
+                        <div>
+                            <h3>{t('throughput')}</h3>
+                            <span>{running ? t('throughputHint') : shell('unavailableTitle')}</span>
+                        </div>
+                        <div className="home-rates">
+                            <div><span className="home-legend is-down">{t('download')}</span><StaticBytes className="home-rate" value={running ? rate.down : 0} rate /></div>
+                            <div><span className="home-legend is-up">{t('upload')}</span><StaticBytes className="home-rate" value={running ? rate.up : 0} rate /></div>
+                        </div>
+                    </div>
+                    <div className="home-chart">
+                        <ThroughputChart samples={sampleRef} updatedAt={rate.at} label={t('throughputHint')} now="" names={['↓', '↑']} />
+                    </div>
+                </Card>
+                <div className="home-stats">
+                    <Card className="home-stat">
+                        <span className="home-stat-label"><Icon type="nav-connections" size={14} />{t('connections')}</span>
+                        <b className="reading">{running ? active.length : '—'}</b>
+                        <span className="home-stat-sub">{running ? t('connectionsHint').replace('{n}', String(processCount)) : shell('unavailableTitle')}</span>
+                    </Card>
+                    <Card className="home-stat">
+                        <span className="home-stat-label"><Icon type="down-arrow-o" size={14} />{t('traffic')}</span>
+                        <b className="reading">{formatTraffic(traffic.downloadTotal)}</b>
+                        <span className="home-stat-sub">{t('trafficHint').replace('{up}', formatTraffic(traffic.uploadTotal))}</span>
+                    </Card>
+                </div>
+            </div>
+
+            <Header level={2} title={t('exits')} meta={t('exitsHint')} />
+            <Card className="home-exits">
+                {exits.length === 0 && <p className="home-exits-empty">{running ? t('noGroups') : shell('unavailableHint')}</p>}
+                {exits.map(group => {
+                    const exit = resolveProxyExit(group.now, groupMap)
+                    const delay = exit ? nodes.get(exit)?.history?.slice(-1)[0]?.delay ?? 0 : 0
+                    const tone = delayStatus(delay)
+                    return (
+                        <button
+                            key={group.name}
+                            type="button"
+                            className="home-exit"
+                            onClick={event => openGroup(group.name, event.currentTarget.querySelector<HTMLElement>('.home-exit-ident'))}
+                        >
+                            <span className="home-exit-ident">
+                                <span className="home-exit-icon"><Icon type={group.type === 'Selector' ? 'nav-proxies' : 'top-speed'} size={20} /></span>
+                                <span className="home-exit-name">
+                                    <b>{group.name}</b>
+                                    <span>{group.type === 'Selector' ? t('manual') : t('auto')} · {exit ?? '—'}</span>
+                                </span>
+                            </span>
+                            <span className={classnames('home-latency', `is-${tone}`)}><i />{delay > 0 ? `${delay} ms` : '—'}</span>
+                            <Icon type="chevron-right" size={16} className="home-exit-chevron" />
+                        </button>
+                    )
+                })}
+            </Card>
+        </div>
+    )
+}
