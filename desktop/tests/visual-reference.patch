diff --git a/src/components/MenuFlyout/index.tsx b/src/components/MenuFlyout/index.tsx
new file mode 100644
index 00000000..0c4e4166
--- /dev/null
+++ b/src/components/MenuFlyout/index.tsx
@@ -0,0 +1,148 @@
+import classnames from 'classnames'
+import { useEffect, useLayoutEffect, useRef, useState, type ReactNode, type RefObject } from 'react'
+import { createPortal } from 'react-dom'
+
+import { Icon } from '../Icon'
+import './style.css'
+
+export interface MenuItem {
+    key: string
+    label?: ReactNode
+    icon?: string
+    // keyboard accelerator shown at the right edge, e.g. "Ctrl+K"
+    accelerator?: string
+    // ToggleMenuFlyoutItem / RadioMenuFlyoutItem state
+    checked?: boolean
+    radio?: boolean
+    disabled?: boolean
+    // a section caption, not an item
+    header?: boolean
+    separator?: boolean
+    onSelect?: () => void
+}
+
+interface MenuFlyoutProps {
+    open: boolean
+    anchor: RefObject<HTMLElement>
+    items: MenuItem[]
+    placement?: 'bottom-start' | 'bottom-end' | 'top-start' | 'top-end' | 'right-start'
+    label?: string
+    className?: string
+    onClose: () => void
+}
+
+/**
+ * WinUI MenuFlyout: acrylic, slides 12px out of its anchor and fades in.
+ * Arrow keys move between items, Enter activates, Escape and outside clicks dismiss.
+ */
+export function MenuFlyout (props: MenuFlyoutProps) {
+    const { open, anchor, items, placement = 'bottom-start', label, className, onClose } = props
+    const menu = useRef<HTMLDivElement>(null)
+    const [style, setStyle] = useState<React.CSSProperties>({ visibility: 'hidden' })
+    const [direction, setDirection] = useState<'down' | 'up' | 'right'>('down')
+
+    useLayoutEffect(() => {
+        if (!open || !anchor.current || !menu.current) return
+        const a = anchor.current.getBoundingClientRect()
+        const m = menu.current.getBoundingClientRect()
+        const vw = window.innerWidth
+        const vh = window.innerHeight
+        let top: number
+        let left: number
+        let dir: 'down' | 'up' | 'right' = 'down'
+        if (placement === 'right-start') {
+            left = a.right + 4
+            top = a.top
+            dir = 'right'
+            if (left + m.width > vw - 8) left = a.left - m.width - 4
+        } else {
+            const wantUp = placement.startsWith('top')
+            const below = a.bottom + 4
+            const above = a.top - m.height - 4
+            dir = wantUp ? (above >= 8 ? 'up' : 'down') : (below + m.height <= vh - 8 || above < 8 ? 'down' : 'up')
+            top = dir === 'up' ? above : below
+            left = placement.endsWith('end') ? a.right - m.width : a.left
+        }
+        setDirection(dir)
+        setStyle({ top: Math.max(8, Math.min(top, vh - m.height - 8)), left: Math.max(8, Math.min(left, vw - m.width - 8)) })
+    }, [open, anchor, placement, items.length])
+
+    useEffect(() => {
+        if (!open) {
+            setStyle({ visibility: 'hidden' })
+            return
+        }
+        const first = menu.current?.querySelector<HTMLButtonElement>('.menu-item:not(:disabled)')
+        first?.focus({ preventScroll: true })
+        function pointer (event: PointerEvent) {
+            const target = event.target as Node
+            if (!menu.current?.contains(target) && !anchor.current?.contains(target)) onClose()
+        }
+        function key (event: KeyboardEvent) {
+            if (event.key === 'Escape') {
+                event.stopPropagation()
+                onClose()
+                anchor.current?.focus({ preventScroll: true })
+            }
+        }
+        function viewport () { onClose() }
+        document.addEventListener('pointerdown', pointer, true)
+        document.addEventListener('keydown', key, true)
+        window.addEventListener('resize', viewport)
+        return () => {
+            document.removeEventListener('pointerdown', pointer, true)
+            document.removeEventListener('keydown', key, true)
+            window.removeEventListener('resize', viewport)
+        }
+    }, [open, anchor, onClose])
+
+    function move (event: React.KeyboardEvent<HTMLDivElement>) {
+        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
+        event.preventDefault()
+        const buttons = Array.from(menu.current?.querySelectorAll<HTMLButtonElement>('.menu-item:not(:disabled)') ?? [])
+        const index = buttons.indexOf(document.activeElement as HTMLButtonElement)
+        const next = event.key === 'ArrowDown' ? (index + 1) % buttons.length : (index - 1 + buttons.length) % buttons.length
+        buttons[next]?.focus({ preventScroll: true })
+    }
+
+    if (!open) return null
+    const leading = items.some(item => item.icon != null || item.checked !== undefined)
+    return createPortal(
+        <div
+            ref={menu}
+            role="menu"
+            aria-label={label}
+            className={classnames('menu-flyout', `menu-flyout-${direction}`, className)}
+            style={style}
+            onKeyDown={move}
+        >
+            {items.map(item => {
+                if (item.separator) return <div key={item.key} className="menu-separator" role="separator" />
+                if (item.header) return <div key={item.key} className="menu-header">{item.label}</div>
+                const role = item.radio ? 'menuitemradio' : item.checked !== undefined ? 'menuitemcheckbox' : 'menuitem'
+                return (
+                    <button
+                        key={item.key}
+                        type="button"
+                        role={role}
+                        aria-checked={item.checked}
+                        disabled={item.disabled}
+                        className={classnames('menu-item', { 'is-radio': item.radio })}
+                        onClick={() => { onClose(); item.onSelect?.() }}
+                    >
+                        {leading && (
+                            <span className="menu-lead" aria-hidden="true">
+                                {item.checked !== undefined
+                                    ? (item.checked ? (item.radio ? <span className="menu-dot" /> : <Icon type="check" size={16} />) : null)
+                                    : item.icon ? <Icon type={item.icon} size={16} /> : null}
+                            </span>
+                        )}
+                        <span className="menu-label">{item.label}</span>
+                        {item.accelerator && <span className="menu-accelerator">{item.accelerator}</span>}
+                    </button>
+                )
+            })}
+        </div>,
+        document.body,
+    )
+}
