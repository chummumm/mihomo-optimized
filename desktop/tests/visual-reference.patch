+// Two-letter region badge for a node name: a flag emoji, a place name or a
+// country code in the name. Unknown names get no badge.
+const REGIONS: Array<[RegExp, string]> = [
+    [/香港|港[区節节]|\bHK\b|Hong\s?Kong/i, 'HK'],
+    [/台湾|台灣|台北|\bTW\b|Taiwan/i, 'TW'],
+    [/日本|东京|東京|大阪|\bJP\b|Japan|Tokyo|Osaka/i, 'JP'],
+    [/新加坡|狮城|獅城|\bSG\b|Singapore/i, 'SG'],
+    [/美国|美國|洛杉矶|圣何塞|硅谷|西雅图|\bUS\b|\bUSA\b|United\s?States|America|Los\s?Angeles|San\s?Jose|Seattle/i, 'US'],
+    [/韩国|韓國|首尔|首爾|\bKR\b|Korea|Seoul/i, 'KR'],
+    [/英国|英國|伦敦|\bUK\b|\bGB\b|Britain|London/i, 'UK'],
+    [/德国|德國|法兰克福|\bDE\b|Germany|Frankfurt/i, 'DE'],
+    [/法国|法國|巴黎|\bFR\b|France|Paris/i, 'FR'],
+    [/荷兰|荷蘭|阿姆斯特丹|\bNL\b|Netherlands|Amsterdam/i, 'NL'],
+    [/加拿大|\bCA\b|Canada/i, 'CA'],
+    [/澳大利亚|澳洲|悉尼|\bAU\b|Australia|Sydney/i, 'AU'],
+    [/俄罗斯|俄羅斯|莫斯科|\bRU\b|Russia|Moscow/i, 'RU'],
+    [/印度|India|Mumbai/i, 'IN'],
+    [/土耳其|\bTR\b|Turkey|Türkiye|Istanbul/i, 'TR'],
+    [/马来西亚|馬來西亞|\bMY\b|Malaysia/i, 'MY'],
+    [/泰国|泰國|\bTH\b|Thailand/i, 'TH'],
+    [/越南|\bVN\b|Vietnam/i, 'VN'],
+    [/菲律宾|\bPH\b|Philippines/i, 'PH'],
+    [/阿根廷|\bAR\b|Argentina/i, 'AR'],
+    [/巴西|\bBR\b|Brazil/i, 'BR'],
+]
+
+const FLAG = /([\u{1F1E6}-\u{1F1FF}])([\u{1F1E6}-\u{1F1FF}])/u
+const cache = new Map<string, string | undefined>()
+
+export function regionOf (name: string): string | undefined {
+    if (cache.has(name)) return cache.get(name)
+    let region: string | undefined
+    const flag = name.match(FLAG)
+    if (flag !== null) {
+        region = String.fromCharCode(flag[1].codePointAt(0)! - 0x1F1E6 + 65, flag[2].codePointAt(0)! - 0x1F1E6 + 65)
+        if (region === 'GB') region = 'UK'
+    } else {
+        region = REGIONS.find(([pattern]) => pattern.test(name))?.[1]
+    }
+    if (cache.size > 2000) cache.clear()
+    cache.set(name, region)
+    return region
+}
