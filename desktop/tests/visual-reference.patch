@@ -0,0 +1,39 @@
+import classnames from 'classnames'
+
+import './style.css'
+
+interface ProgressRingProps {
+    size?: number
+    // 0..1 for a determinate ring; omit for the indeterminate spinner
+    value?: number
+    className?: string
+    label?: string
+}
+
+// WinUI ProgressRing: an arc that grows and shrinks while it turns.
+export function ProgressRing ({ size = 16, value, className, label }: ProgressRingProps) {
+    const stroke = size >= 40 ? 3 : size >= 24 ? 2.5 : 2
+    const r = size / 2 - stroke
+    const determinate = value !== undefined
+    return (
+        <svg
+            className={classnames('progress-ring', { 'is-determinate': determinate }, className)}
+            width={size}
+            height={size}
+            viewBox={`0 0 ${size} ${size}`}
+            role={label ? 'progressbar' : undefined}
+            aria-label={label}
+            aria-hidden={label ? undefined : true}
+            aria-valuenow={determinate ? Math.round(value * 100) : undefined}
+        >
+            <circle
+                cx={size / 2}
+                cy={size / 2}
+                r={r}
+                strokeWidth={stroke}
+                pathLength={100}
+                style={determinate ? { strokeDasharray: `${Math.max(0, Math.min(1, value)) * 100} 100` } : undefined}
+            />
+        </svg>
+    )
+}
