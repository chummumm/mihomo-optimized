diff --git a/src/containers/Shell/CoreCard.tsx b/src/containers/Shell/CoreCard.tsx
new file mode 100644
index 00000000..de58a851
--- /dev/null
+++ b/src/containers/Shell/CoreCard.tsx
@@ -0,0 +1,89 @@
+import classnames from 'classnames'
+import { useAtomValue, useSetAtom } from 'jotai'
+import { useRef, useState } from 'react'
+import { useNavigate } from 'react-router-dom'
+
+import { Icon, MenuFlyout, ProgressRing, error as toastError, type MenuItem } from '@components'
+import { identityAtom, useI18n, useVersion } from '@stores'
+
+import { desktopAction, isDesktop, useDesktop } from '../../platform/desktop'
+import { desktopError } from '../../platform/model'
+
+function shortVersion (version: string) {
+    return version.startsWith('mihomo-optimized-v') ? version.slice('mihomo-optimized-'.length) : version
+}
+
+/**
+ * The account-card slot of Windows Settings, used for the core: its state and
+ * version at a glance, and a menu with the core actions. Compact rails keep
+ * only the avatar and its status dot.
+ */
+export function CoreCard ({ compact }: { compact: boolean }) {
+    const { translation } = useI18n()
+    const { t } = translation('Shell')
+    const navigate = useNavigate()
+    const desktop = useDesktop()
+    const { version } = useVersion()
+    const reachable = useAtomValue(identityAtom)
+    const setIdentity = useSetAtom(identityAtom)
+    const anchor = useRef<HTMLButtonElement>(null)
+    const [open, setOpen] = useState(false)
+
+    const phase = isDesktop()
+        ? desktop.status?.phase ?? (desktop.ready ? 'error' : 'starting')
+        : reachable && version !== '' ? 'running' : 'stopped'
+    const busy = phase === 'starting' || phase === 'stopping' || !!desktop.busy
+    const running = phase === 'running'
+    const coreVersion = isDesktop() ? desktop.status?.coreVersion ?? version : version
+    const state = isDesktop()
+        ? t(`core.${phase}` as 'core.running')
+        : t(running ? 'core.online' : 'core.offline')
+    const sub = coreVersion ? t('core.version').replace('{v}', shortVersion(coreVersion)) : '—'
+
+    function run (command: string) {
+        void desktopAction(command).catch(reason => { toastError(desktopError(reason).message) })
+    }
+
+    const items: MenuItem[] = isDesktop()
+        ? [
+            { key: 'head', header: true, label: `${t('core.title')} · ${state}` },
+            running
+                ? { key: 'stop', icon: 'stop', label: t('commands.stopCore'), disabled: busy, onSelect: () => run('desktop_stop') }
+                : { key: 'start', icon: 'play', label: t('commands.startCore'), disabled: busy || !desktop.status, onSelect: () => run('desktop_start') },
+            { key: 'restart', icon: 'update', label: t('commands.restartCore'), disabled: busy || !running, onSelect: () => run('desktop_restart') },
+            { key: 'sep', separator: true },
+            { key: 'profiles', icon: 'nav-profiles', label: t('core.openProfiles'), onSelect: () => navigate('/profiles') },
+            { key: 'logs', icon: 'nav-logs', label: t('core.openLogs'), disabled: !running, onSelect: () => navigate('/logs') },
+        ]
+        : [
+            { key: 'head', header: true, label: `${t('core.title')} · ${state}` },
+            { key: 'controller', icon: 'setting', label: t('core.controller'), onSelect: () => setIdentity(false) },
+            { key: 'logs', icon: 'nav-logs', label: t('core.openLogs'), disabled: !running, onSelect: () => navigate('/logs') },
+        ]
+
+    return (
+        <>
+            <button
+                ref={anchor}
+                type="button"
+                className={classnames('core-card', `is-${phase}`, { 'is-compact': compact })}
+                aria-haspopup="menu"
+                aria-expanded={open}
+                aria-label={`${t('core.title')}：${state} · ${sub}`}
+                title={compact ? `${state} · ${sub}` : undefined}
+                onClick={() => setOpen(value => !value)}
+            >
+                <span className="core-avatar">
+                    {busy && <ProgressRing size={48} className="core-avatar-ring" />}
+                    <Icon type={running ? 'globe-shield' : 'power'} size={20} filled={running} />
+                    <span className="core-dot" aria-hidden="true" />
+                </span>
+                <span className="core-card-meta">
+                    <b>{state}</b>
+                    <span>{sub}</span>
+                </span>
+            </button>
+            <MenuFlyout open={open} anchor={anchor} items={items} label={t('core.title')} placement={compact ? 'right-start' : 'bottom-start'} onClose={() => setOpen(false)} />
+        </>
+    )
+}
