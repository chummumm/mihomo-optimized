@@ -0,0 +1,449 @@
+/* ---------- title bar (desktop) ---------- */
+.titlebar {
+    position: relative;
+    z-index: calc(var(--z-rail) + 1);
+    display: flex;
+    flex: none;
+    align-items: center;
+    gap: 4px;
+    height: var(--titlebar-h);
+    padding-left: 4px;
+    user-select: none;
+    -webkit-user-select: none;
+}
+
+.titlebar-left {
+    display: flex;
+    flex: none;
+    align-items: center;
+    gap: 2px;
+    min-width: 0;
+}
+
+.titlebar-button {
+    display: grid;
+    flex: none;
+    place-items: center;
+    width: 40px;
+    height: 36px;
+    border-radius: var(--r-ctl);
+    color: var(--text);
+    cursor: default;
+    transition: background-color var(--dur-1) linear;
+}
+
+.titlebar-button:hover:not(:disabled) {
+    background: var(--subtle-hover);
+}
+
+.titlebar-button:active:not(:disabled) {
+    background: var(--subtle-press);
+    color: var(--text-2);
+}
+
+.titlebar-button:disabled {
+    color: var(--text-dis);
+}
+
+.titlebar-app {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    min-width: 0;
+    padding: 0 8px 0 10px;
+}
+
+.titlebar-icon {
+    width: 16px;
+    height: 16px;
+    flex: none;
+}
+
+.titlebar-title,
+.titlebar-sub {
+    overflow: hidden;
+    font-size: var(--t-xs);
+    line-height: 16px;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    transition: color var(--dur-2) linear;
+}
+
+.titlebar-sub {
+    color: var(--text-3);
+}
+
+.is-window-inactive .titlebar-title,
+.is-window-inactive .titlebar-sub,
+.is-window-inactive .caption-button {
+    color: var(--text-dis);
+}
+
+.titlebar-center {
+    display: flex;
+    flex: 1 1 0;
+    justify-content: center;
+    min-width: 0;
+    padding: 0 12px;
+}
+
+.titlebar-caption {
+    display: flex;
+    flex: none;
+    align-self: stretch;
+}
+
+.caption-button {
+    display: grid;
+    place-items: center;
+    width: 46px;
+    height: 100%;
+    color: var(--text);
+    cursor: default;
+    transition: background-color var(--dur-1) linear;
+}
+
+.caption-button:hover {
+    background: var(--subtle-hover);
+}
+
+.caption-button:active {
+    background: var(--subtle-press);
+    color: var(--text-2);
+}
+
+.caption-close:hover {
+    background: var(--close-hover);
+    color: #ffffff;
+}
+
+.caption-close:active {
+    background: color-mix(in srgb, var(--close-hover) 90%, transparent);
+    color: rgb(255 255 255 / 70%);
+}
+
+@container (max-width: 640px) {
+    .titlebar-title,
+    .titlebar-sub {
+        display: none;
+    }
+}
+
+@media (max-width: 640px) {
+    .titlebar-title,
+    .titlebar-sub,
+    .auto-suggest-key {
+        display: none;
+    }
+}
+
+@media (max-width: 440px) {
+    .titlebar-app {
+        display: none;
+    }
+
+    .titlebar-center {
+        padding: 0 4px;
+    }
+}
+
+/* Web panel without a title bar: the pane toggle floats over the content in minimal mode. */
+.pane-float {
+    position: absolute;
+    z-index: var(--z-rail);
+    top: 6px;
+    left: 4px;
+    background: var(--acrylic);
+    -webkit-backdrop-filter: blur(20px);
+    backdrop-filter: blur(20px);
+}
+
+.nav-minimal:not(.is-desktop) .page {
+    padding-top: 52px;
+}
+
+/* ---------- AutoSuggestBox ---------- */
+.auto-suggest {
+    position: relative;
+    width: min(100%, 380px);
+    height: 32px;
+}
+
+.nav-search .auto-suggest {
+    width: 100%;
+}
+
+.nav-search .auto-suggest-key {
+    display: none;
+}
+
+.auto-suggest:has(.auto-suggest-key) .auto-suggest-input {
+    padding-right: 88px;
+}
+
+.auto-suggest-input {
+    width: 100%;
+    height: 32px;
+    padding: 0 34px 0 11px;
+    border: 1px solid var(--ctl-stroke);
+    border-radius: var(--r-ctl);
+    background: var(--ctl);
+    background-clip: padding-box;
+    color: var(--text);
+    font-size: var(--t-md);
+    box-shadow: inset 0 -1px 0 var(--ctl-strong);
+    transition: background-color var(--dur-1) linear;
+}
+
+.auto-suggest-input::placeholder {
+    color: var(--text-2);
+}
+
+.auto-suggest-input:hover {
+    background: var(--ctl-hover);
+    background-clip: padding-box;
+}
+
+.auto-suggest-input:focus {
+    outline: none;
+    background: var(--ctl-focus);
+    box-shadow: inset 0 -2px 0 var(--accent);
+}
+
+.auto-suggest-glyph {
+    position: absolute;
+    top: 8px;
+    right: 10px;
+    color: var(--text-2);
+    pointer-events: none;
+}
+
+.auto-suggest-key {
+    position: absolute;
+    top: 7px;
+    right: 32px;
+    padding: 0 4px;
+    border: 1px solid var(--divider);
+    border-radius: 3px;
+    color: var(--text-3);
+    font-family: var(--font-sans);
+    font-size: 11px;
+    line-height: 16px;
+    pointer-events: none;
+}
+
+.auto-suggest-list {
+    position: fixed;
+    z-index: var(--z-popover);
+    max-height: 380px;
+    padding: 4px;
+    overflow: auto;
+    border: 1px solid var(--acrylic-stroke);
+    border-radius: var(--r-overlay);
+    background: var(--acrylic);
+    background-clip: padding-box;
+    box-shadow: var(--shadow-flyout);
+    -webkit-backdrop-filter: blur(30px) saturate(1.5);
+    backdrop-filter: blur(30px) saturate(1.5);
+    animation: menu-down var(--dur-3) var(--ease-out);
+}
+
+.auto-suggest-item {
+    position: relative;
+    display: grid;
+    grid-template-columns: 16px minmax(0, 1fr) auto;
+    gap: 12px;
+    align-items: center;
+    min-height: 40px;
+    padding: 4px 11px;
+    border-radius: var(--r-ctl);
+    color: var(--text);
+    cursor: default;
+}
+
+.auto-suggest-item .icon {
+    color: var(--text-2);
+}
+
+.auto-suggest-item.active {
+    background: var(--subtle-hover);
+}
+
+.auto-suggest-item.active::before {
+    content: '';
+    position: absolute;
+    top: 50%;
+    left: 0;
+    width: 3px;
+    height: 16px;
+    margin-top: -8px;
+    border-radius: 2px;
+    background: var(--accent);
+}
+
+.auto-suggest-text {
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+}
+
+.auto-suggest-text b,
+.auto-suggest-text span {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.auto-suggest-text b {
+    font-weight: 400;
+}
+
+.auto-suggest-text span {
+    color: var(--text-2);
+    font-size: var(--t-xs);
+    line-height: 16px;
+}
+
+.auto-suggest-text mark {
+    background: none;
+    color: var(--accent-text);
+    font-weight: 600;
+}
+
+.auto-suggest-category {
+    color: var(--text-3);
+    font-size: var(--t-xs);
+}
+
+.auto-suggest-empty {
+    padding: 12px;
+    color: var(--text-2);
+    font-size: var(--t-sm);
+}
+
+/* ---------- core card (the account-card slot of Windows Settings) ---------- */
+.core-card {
+    display: flex;
+    flex: none;
+    align-items: center;
+    gap: 12px;
+    width: calc(100% - 8px);
+    min-width: 0;
+    margin: 2px 4px 8px;
+    padding: 8px;
+    border-radius: var(--r-ctl);
+    color: var(--text);
+    text-align: left;
+    cursor: default;
+    transition: background-color var(--dur-1) linear;
+}
+
+.core-card:hover {
+    background: var(--subtle-hover);
+}
+
+.core-card:active {
+    background: var(--subtle-press);
+}
+
+.core-card.is-compact {
+    width: 40px;
+    padding: 0;
+    justify-content: center;
+}
+
+.core-avatar {
+    position: relative;
+    display: grid;
+    flex: none;
+    place-items: center;
+    width: 40px;
+    height: 40px;
+    border-radius: 50%;
+    background: var(--ctl-alt);
+    color: var(--text-2);
+    transition: background-color var(--dur-3) linear, color var(--dur-3) linear;
+}
+
+.core-card.is-running .core-avatar {
+    background: var(--accent);
+    color: var(--on-accent);
+}
+
+.core-avatar-ring {
+    position: absolute;
+    inset: -4px;
+}
+
+.core-dot {
+    position: absolute;
+    right: 0;
+    bottom: 0;
+    width: 12px;
+    height: 12px;
+    border-radius: 50%;
+    background: var(--text-3);
+    box-shadow: 0 0 0 2px var(--mica-ring, var(--dlg-bottom));
+    transition: background-color var(--dur-3) linear;
+}
+
+.core-card.is-running .core-dot { background: var(--success); }
+.core-card.is-starting .core-dot,
+.core-card.is-stopping .core-dot { background: var(--caution); }
+.core-card.is-error .core-dot { background: var(--critical); }
+
+.core-card-meta {
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+    white-space: nowrap;
+    transition: opacity var(--dur-2) linear;
+}
+
+.core-card-meta b {
+    font-size: var(--t-md);
+    font-weight: 600;
+    line-height: 20px;
+}
+
+.core-card-meta span {
+    overflow: hidden;
+    color: var(--text-2);
+    font-size: var(--t-xs);
+    line-height: 16px;
+    text-overflow: ellipsis;
+}
+
+/* ---------- drop target (desktop) ---------- */
+.drop-target {
+    position: fixed;
+    inset: 8px;
+    z-index: var(--z-modal);
+    display: grid;
+    place-items: center;
+    padding: var(--sp-6);
+    border: 2px dashed var(--accent);
+    border-radius: var(--r-overlay);
+    background: color-mix(in srgb, var(--accent) 12%, var(--dlg-bottom));
+    text-align: center;
+    pointer-events: none;
+    animation: loading-in var(--dur-2) linear;
+}
+
+.drop-target b {
+    display: block;
+    margin-top: 10px;
+    font-family: var(--font-display);
+    font-size: var(--t-xl);
+    font-weight: 600;
+    line-height: 28px;
+}
+
+.drop-target span {
+    color: var(--text-2);
+}
+
+.drop-target .icon {
+    margin: 0 auto;
+    color: var(--accent-text);
+}
