index 00000000..f50d960e
--- /dev/null
+++ b/src/components/SubPage/index.tsx
@@ -0,0 +1,143 @@
+import classnames from 'classnames'
+import { motion } from 'motion/react'
+import { useEffect, useLayoutEffect, useRef, useState, useSyncExternalStore, type CSSProperties, type ReactNode } from 'react'
+import { createPortal } from 'react-dom'
+
+import { type BaseComponentProps } from '@models'
+import { useI18n } from '@stores'
+
+import { Icon } from '../Icon'
+import './style.css'
+
+interface SubPageProps extends BaseComponentProps {
+    show: boolean
+    // breadcrumb: the page this one was opened from, then this page
+    parent: string
+    title: string
+    bodyClassName?: string
+    // header extras on the right, such as a file name
+    aside?: ReactNode
+    onClose: () => void
+}
+
+// Open sub-pages, newest last. The title bar's back button and Alt+← close the
+// top one instead of leaving the route underneath it.
+const open: Array<{ close: () => void }> = []
+const listeners = new Set<() => void>()
+function notify () { for (const listener of listeners) listener() }
+
+export function hasOpenSubPage () {
+    return open.length > 0
+}
+
+export function useSubPageOpen () {
+    return useSyncExternalStore(listener => { listeners.add(listener); return () => { listeners.delete(listener) } }, hasOpenSubPage, () => false)
+}
+
+export function closeTopSubPage () {
+    const top = open[open.length - 1]
+    if (top === undefined) return false
+    top.close()
+    return true
+}
+
+// Small or short touch screens get the whole viewport.
+const FULL = '(max-width: 768px), (max-height: 500px) and (pointer: coarse)'
+function subscribeFull (listener: () => void) {
+    const query = window.matchMedia(FULL)
+    query.addEventListener('change', listener)
+    return () => query.removeEventListener('change', listener)
+}
+function useFullScreen () {
+    return useSyncExternalStore(subscribeFull, () => window.matchMedia(FULL).matches, () => false)
+}
+
+function useFrameRect (active: boolean, phone: boolean) {
+    const [rect, setRect] = useState<CSSProperties>({ inset: 0 })
+    useLayoutEffect(() => {
+        if (!active) return
+        const frame = document.getElementById('frame')
+        if (frame === null || phone) { setRect({ inset: 0 }); return }
+        const measure = () => {
+            const box = frame.getBoundingClientRect()
+            setRect({ top: box.top, left: box.left, width: box.width, height: box.height })
+        }
+        measure()
+        const observer = new ResizeObserver(measure)
+        observer.observe(frame)
+        window.addEventListener('resize', measure)
+        return () => {
+            observer.disconnect()
+            window.removeEventListener('resize', measure)
+        }
+    }, [active, phone])
+    return rect
+}
+
+/**
+ * A drill-in page that covers the content area (navigation and title bar stay
+ * put), as Windows Settings does for a sub-page. Phones get the whole screen.
+ * The page under it is inert until it closes.
+ */
+export function SubPage ({ show, parent, title, aside, onClose, className, bodyClassName, style, children }: SubPageProps) {
+    const { translation } = useI18n()
+    const { t } = translation('Shell')
+    const phone = useFullScreen()
+    const rect = useFrameRect(show, phone)
+    const onCloseRef = useRef(onClose)
+    onCloseRef.current = onClose
+    const sectionRef = useRef<HTMLElement>(null)
+    useEffect(() => { if (sectionRef.current) sectionRef.current.inert = !show }, [show])
+
+    useEffect(() => {
+        if (!show) return
+        const entry = { close: () => onCloseRef.current() }
+        open.push(entry)
+        notify()
+        const blocked = Array.from(document.querySelectorAll<HTMLElement>('#frame, .nav-slot, .titlebar-center, .nav-scrim'))
+        for (const element of blocked) element.inert = true
