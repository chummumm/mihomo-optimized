+++ b/src/components/SettingsCard/index.tsx
@@ -0,0 +1,49 @@
+import classnames from 'classnames'
+import { type ReactNode } from 'react'
+
+import { Icon } from '../Icon'
+import './style.css'
+
+interface SettingsCardProps {
+    id?: string
+    icon?: string
+    title: ReactNode
+    description?: ReactNode
+    children?: ReactNode
+    // content below the header row, e.g. inputs that need the full width
+    footer?: ReactNode
+    className?: string
+    onClick?: () => void
+    ariaLabel?: string
+}
+
+/**
+ * Windows Settings card: icon, title and description on the left, the control
+ * on the right. Clickable cards end in a chevron and act as one button.
+ */
+export function SettingsCard ({ id, icon, title, description, children, footer, className, onClick, ariaLabel }: SettingsCardProps) {
+    const body = <>
+        {icon && <Icon type={icon} size={20} className="settings-item-icon" />}
+        <span className="settings-item-text">
+            <span className="settings-item-title">{title}</span>
+            {description && <span className="settings-item-desc">{description}</span>}
+        </span>
+        {children != null && <span className="settings-item-control">{children}</span>}
+        {onClick && <Icon type="chevron-right" size={16} className="settings-item-chevron" />}
+    </>
+    if (onClick) {
+        return <button type="button" id={id} className={classnames('settings-item', 'is-clickable', className)} aria-label={ariaLabel} onClick={onClick}>{body}</button>
+    }
+    return <div id={id} tabIndex={id ? -1 : undefined} className={classnames('settings-item', { 'has-footer': footer != null }, className)}>
+        <div className="settings-item-row">{body}</div>
+        {footer != null && <div className="settings-item-footer">{footer}</div>}
+    </div>
+}
+
+// ToggleSwitch with its On/Off text on the left, as in Windows Settings.
+export function SettingToggle ({ checked, onText, offText, children }: { checked: boolean, onText: string, offText: string, children: ReactNode }) {
+    return <span className="setting-toggle">
+        <span className="setting-toggle-state" aria-hidden="true">{checked ? onText : offText}</span>
+        {children}
+    </span>
+}
