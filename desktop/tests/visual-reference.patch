+++ b/src/containers/Shell/GlobalSearch.tsx
@@ -0,0 +1,208 @@
+import classnames from 'classnames'
+import { useAtomValue } from 'jotai'
+import { forwardRef, useEffect, useImperativeHandle, useLayoutEffect, useMemo, useRef, useState } from 'react'
+import { createPortal } from 'react-dom'
+import { useNavigate } from 'react-router-dom'
+
+import { Icon, error as toastError } from '@components'
+import { proxies as proxiesAtom, rules as rulesAtom, useClient, useGeneral, useI18n } from '@stores'
+
+import { SETTING_TARGETS } from './search-targets'
+import { desktopAction, isDesktop, setDesktopDialog, useDesktop } from '../../platform/desktop'
+import { desktopError } from '../../platform/model'
+
+interface Result {
+    key: string
+    category: 'command' | 'page' | 'group' | 'node' | 'setting' | 'rule'
+    icon: string
+    title: string
+    detail: string
+    keywords?: string
+    run: () => void
+}
+
+export interface GlobalSearchHandle { focus: () => void }
+
+function highlight (text: string, query: string) {
+    if (!query) return text
+    const index = text.toLowerCase().indexOf(query.toLowerCase())
+    if (index < 0) return text
+    return <>{text.slice(0, index)}<mark>{text.slice(index, index + query.length)}</mark>{text.slice(index + query.length)}</>
+}
+
+/**
+ * WinUI AutoSuggestBox used as a command palette: pages, policy groups, nodes,
+ * rules, settings and commands. Enter runs the highlighted result; settings and
+ * nodes open their page and flash the target.
+ */
+export const GlobalSearch = forwardRef<GlobalSearchHandle, { pages: Array<{ path: string, name: string, icon: string }> }>(function GlobalSearch ({ pages }, ref) {
+    const { translation } = useI18n()
+    const { t } = translation('Shell')
+    const { t: nav } = translation('SideBar')
+    const navigate = useNavigate()
+    const desktop = useDesktop()
+    const client = useClient()
+    const { general, update: refreshGeneral } = useGeneral()
+    const { groups, proxies } = useAtomValue(proxiesAtom)
+    const rules = useAtomValue(rulesAtom)
+    const input = useRef<HTMLInputElement>(null)
+    const box = useRef<HTMLDivElement>(null)
+    const list = useRef<HTMLDivElement>(null)
+    const [query, setQuery] = useState('')
+    const [open, setOpen] = useState(false)
+    const [active, setActive] = useState(0)
+    const [position, setPosition] = useState<React.CSSProperties>({})
+
+    useImperativeHandle(ref, () => ({ focus: () => { input.current?.focus(); setOpen(true) } }))
+
+    const results = useMemo(() => {
+        const out: Result[] = []
+        const phase = desktop.status?.phase
+        const run = (command: string, args?: Record<string, unknown>) => () => {
+            void desktopAction(command, args).catch(reason => { toastError(desktopError(reason).message) })
+        }
+        if (isDesktop() && desktop.status) {
+            out.push(phase === 'running'
+                ? { key: 'cmd-stop', category: 'command', icon: 'stop', title: t('commands.stopCore'), detail: t(`core.${phase}`), keywords: 'core stop', run: run('desktop_stop') }
+                : { key: 'cmd-start', category: 'command', icon: 'play', title: t('commands.startCore'), detail: t(`core.${phase ?? 'stopped'}` as 'core.stopped'), keywords: 'core start', run: run('desktop_start') })
+            out.push({ key: 'cmd-proxy', category: 'command', icon: 'nav-proxies', title: t(desktop.status.systemProxy ? 'commands.systemProxyOff' : 'commands.systemProxyOn'), detail: '', keywords: 'system proxy', run: run('desktop_set_system_proxy', { enabled: !desktop.status.systemProxy }) })
+            out.push({ key: 'cmd-tun', category: 'command', icon: 'shield-lock', title: t(desktop.status.tun ? 'commands.tunOff' : 'commands.tunOn'), detail: 'TUN', keywords: 'tun', run: () => navigate('/', { state: { toggleTun: true } }) })
+            out.push({ key: 'cmd-import', category: 'command', icon: 'arrow-import', title: t('commands.importConfig'), detail: '', keywords: 'import yaml subscription', run: () => { navigate('/profiles'); setDesktopDialog('import') } })
+        }
+        out.push({ key: 'cmd-test', category: 'command', icon: 'speed', title: t('commands.testAll'), detail: 'Ctrl+T', keywords: 'latency speed test', run: () => navigate('/proxies', { state: { testAll: Date.now() } }) })
+        out.push({ key: 'cmd-edit', category: 'command', icon: 'edit', title: t('commands.editConfig'), detail: '', keywords: 'yaml config editor', run: () => navigate('/profiles', { state: { edit: Date.now() } }) })
+        for (const mode of ['rule', 'global', 'direct'] as const) {
+            out.push({
+                key: 'mode-' + mode,
+                category: 'command',
+                icon: 'arrow-swap',
+                title: t(`commands.mode${mode[0].toUpperCase()}${mode.slice(1)}` as 'commands.modeRule'),
+                detail: general.mode === mode ? t('commands.currentMode') : t(`modes.${mode}`),
+                keywords: 'mode ' + mode,
+                run: () => { void client.updateConfig({ mode }).then(() => refreshGeneral()).catch(() => undefined) },
+            })
+        }
+        for (const page of pages) {
+            out.push({ key: 'page-' + page.path, category: 'page', icon: page.icon, title: nav(page.name as 'Proxies'), detail: page.path, keywords: page.name, run: () => navigate(page.path) })
+        }
+        for (const group of groups) {
+            out.push({ key: 'group-' + group.name, category: 'group', icon: 'nav-proxies', title: group.name, detail: `${group.type} · ${group.now || '—'}`, run: () => navigate('/proxies', { state: { focusGroup: group.name } }) })
+        }
+        for (const proxy of proxies) {
+            const history = proxy.history
+            const delay = history?.length ? history[history.length - 1].delay : 0
+            out.push({ key: 'node-' + proxy.name, category: 'node', icon: 'globe', title: proxy.name, detail: `${proxy.type}${delay ? ` · ${delay} ms` : ''}`, run: () => navigate('/proxies', { state: { focusNode: proxy.name } }) })
+        }
+        for (const target of SETTING_TARGETS) {
+            if ((target.desktopOnly && !isDesktop()) || (target.webOnly && isDesktop())) continue
+            const label = translation(target.namespace).t(target.label as never) as string
+            out.push({ key: 'set-' + target.id, category: 'setting', icon: 'setting', title: label, detail: nav('Settings'), keywords: target.keywords, run: () => navigate(target.page ?? '/settings', { state: { focus: target.id } }) })
+        }
+        for (const [index, rule] of rules.entries()) {
+            if (!rule.payload) continue
+            out.push({ key: `rule-${index}`, category: 'rule', icon: 'nav-rules', title: rule.payload, detail: `${rule.type} → ${rule.proxy}`, keywords: rule.proxy, run: () => navigate('/rules', { state: { query: rule.payload } }) })
+        }
+        return out
+    }, [client, desktop.status, general.mode, groups, nav, navigate, pages, proxies, refreshGeneral, rules, t, translation])
+
+    const shown = useMemo(() => {
+        const q = query.trim().toLowerCase()
+        if (!q) return results.filter(result => result.category === 'command').slice(0, 6)
+        const matches = results.filter(result => `${result.title} ${result.detail} ${result.keywords ?? ''}`.toLowerCase().includes(q))
+        return matches.sort((a, b) => Number(b.title.toLowerCase().startsWith(q)) - Number(a.title.toLowerCase().startsWith(q))).slice(0, 8)
+    }, [query, results])
+
+    useEffect(() => { setActive(0) }, [query])
+
+    useLayoutEffect(() => {
+        if (!open || !box.current) return
+        const rect = box.current.getBoundingClientRect()
+        const width = Math.max(rect.width, 320)
+        setPosition({ top: rect.bottom + 4, left: Math.max(8, Math.min(rect.left, window.innerWidth - width - 8)), width })
+    }, [open, query])
+
+    useEffect(() => {
+        if (!open) return
+        function pointer (event: PointerEvent) {
+            const target = event.target as Node
+            if (!box.current?.contains(target) && !list.current?.contains(target)) setOpen(false)
+        }
+        document.addEventListener('pointerdown', pointer, true)
+        window.addEventListener('resize', () => setOpen(false), { once: true })
+        return () => document.removeEventListener('pointerdown', pointer, true)
+    }, [open])
+
+    function choose (result: Result | undefined) {
+        if (!result) return
+        setOpen(false)
+        setQuery('')
+        input.current?.blur()
+        result.run()
+    }
+
+    function keydown (event: React.KeyboardEvent<HTMLInputElement>) {
+        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+            event.preventDefault()
+            setOpen(true)
+            if (shown.length === 0) return
+            setActive(index => event.key === 'ArrowDown' ? (index + 1) % shown.length : (index - 1 + shown.length) % shown.length)
+        } else if (event.key === 'Enter') {
+            event.preventDefault()
+            choose(shown[active])
+        } else if (event.key === 'Escape') {
+            setOpen(false)
+            setQuery('')
+            input.current?.blur()
+        }
+    }
+
+    const listID = 'global-search-results'
+    return (
+        <div ref={box} className="auto-suggest">
+            <input
+                ref={input}
+                className="auto-suggest-input"
+                type="text"
+                role="combobox"
+                aria-expanded={open}
+                aria-controls={listID}
+                aria-autocomplete="list"
+                aria-label={t('searchLabel')}
+                placeholder={t('search')}
+                autoComplete="off"
+                spellCheck={false}
+                value={query}
+                onChange={event => { setQuery(event.target.value); setOpen(true) }}
+                onFocus={() => setOpen(true)}
+                onKeyDown={keydown}
+            />
+            {!query && <kbd className="auto-suggest-key" aria-hidden="true">Ctrl+K</kbd>}
+            <Icon type="search" size={16} className="auto-suggest-glyph" />
+            {open && createPortal(
+                <div ref={list} id={listID} role="listbox" className="auto-suggest-list" style={position}>
+                    {!query && <div className="menu-header">{t('searchHint')}</div>}
+                    {shown.length === 0 && <p className="auto-suggest-empty">{t('searchEmpty').replace('{q}', query.trim())}</p>}
+                    {shown.map((result, index) => (
+                        <div
+                            key={result.key}
+                            role="option"
+                            aria-selected={index === active}
+                            className={classnames('auto-suggest-item', { active: index === active })}
+                            onPointerEnter={() => setActive(index)}
+                            onPointerDown={event => event.preventDefault()}
+                            onClick={() => choose(result)}
+                        >
+                            <Icon type={result.icon} size={16} />
+                            <span className="auto-suggest-text">
+                                <b>{highlight(result.title, query.trim())}</b>
+                                {result.detail && <span>{result.detail}</span>}
+                            </span>
+                            <span className="auto-suggest-category">{t(`categories.${result.category}`)}</span>
+                        </div>
+                    ))}
+                </div>,
+                document.body,
+            )}
+        </div>
+    )
+})
diff --git a/src/containers/Shell/TitleBar.tsx b/src/containers/Shell/TitleBar.tsx
new file mode 100644
index 00000000..ea6b15aa
--- /dev/null
+++ b/src/containers/Shell/TitleBar.tsx
@@ -0,0 +1,91 @@
+import classnames from 'classnames'
+import { useEffect, useState, type ReactNode } from 'react'
+import { useLocation, useNavigate } from 'react-router-dom'
+
+import logo from '@assets/logo.png'
+import { Icon, closeTopSubPage, useSubPageOpen } from '@components'
+import { useI18n } from '@stores'
+
+type Window = Awaited<ReturnType<typeof loadWindow>>
+
+async function loadWindow () {
+    const { getCurrentWindow } = await import('@tauri-apps/api/window')
+    return getCurrentWindow()
+}
+
+/**
+ * Tall (48px) WinUI title bar drawn by the page: back, pane toggle, app
+ * identity and search, then the caption buttons. The empty parts are drag
+ * regions; double-clicking them maximizes, as on a native title bar.
+ */
+export function TitleBar ({ onTogglePane, search, subtitle }: { onTogglePane: () => void, search?: ReactNode, subtitle?: string }) {
+    const { translation } = useI18n()
+    const { t } = translation('Shell')
+    const navigate = useNavigate()
+    // Re-render on navigation so the back button tracks the history position.
+    useLocation()
+    const [win, setWin] = useState<Window | null>(null)
+    const [maximized, setMaximized] = useState(false)
+    const [active, setActive] = useState(() => document.hasFocus())
+    // React Router keeps the position in its history entry; idx 0 has nothing behind it.
+    const subPage = useSubPageOpen()
+    const canGoBack = ((window.history.state as { idx?: number } | null)?.idx ?? 0) > 0
+
+    useEffect(() => {
+        let disposed = false
+        let unlisten: (() => void) | undefined
+        void loadWindow().then(current => {
+            if (disposed) return
+            setWin(current)
+            void current.isMaximized().then(value => { if (!disposed) setMaximized(value) }).catch(() => undefined)
+            void current.onResized(() => {
+                void current.isMaximized().then(value => { if (!disposed) setMaximized(value) }).catch(() => undefined)
+            }).then(off => { if (disposed) off(); else unlisten = off }).catch(() => undefined)
+        }).catch(() => undefined)
+        return () => { disposed = true; unlisten?.() }
+    }, [])
+
+    useEffect(() => {
+        function focus () { setActive(true) }
+        function blur () { setActive(false) }
+        window.addEventListener('focus', focus)
+        window.addEventListener('blur', blur)
+        return () => { window.removeEventListener('focus', focus); window.removeEventListener('blur', blur) }
+    }, [])
+
+    useEffect(() => {
+        document.documentElement.classList.toggle('is-window-inactive', !active)
+    }, [active])
+
+    return (
+        <header className={classnames('titlebar', { 'is-inactive': !active })} data-tauri-drag-region>
+            <div className="titlebar-left">
+                <button type="button" className="titlebar-button" disabled={!canGoBack && !subPage} aria-label={t('back')} title={`${t('back')} (Alt+←)`} onClick={() => { if (!closeTopSubPage()) navigate(-1) }}>
+                    <Icon type="arrow-left" size={16} />
+                </button>
+                <button type="button" className="titlebar-button" aria-label={t('togglePane')} title={t('togglePane')} onClick={onTogglePane}>
+                    <Icon type="navigation" size={16} />
+                </button>
+                <span className="titlebar-app" data-tauri-drag-region>
+                    <img src={logo} alt="" className="titlebar-icon" data-tauri-drag-region />
+                    <span className="titlebar-title" data-tauri-drag-region>{t('appName')}</span>
+                    {subtitle && <span className="titlebar-sub" data-tauri-drag-region>· {subtitle}</span>}
+                </span>
+            </div>
+            <div className="titlebar-center" data-tauri-drag-region>
+                {search}
+            </div>
+            <div className="titlebar-caption">
+                <button type="button" className="caption-button" aria-label={t('minimize')} title={t('minimize')} onClick={() => { void win?.minimize() }}>
+                    <Icon type="minimize" size={16} />
+                </button>
+                <button type="button" className="caption-button" aria-label={maximized ? t('restore') : t('maximize')} title={maximized ? t('restore') : t('maximize')} onClick={() => { void win?.toggleMaximize() }}>
+                    <Icon type={maximized ? 'restore' : 'maximize'} size={16} />
+                </button>
+                <button type="button" className="caption-button caption-close" aria-label={t('close')} title={t('close')} onClick={() => { void win?.close() }}>
+                    <Icon type="dismiss" size={16} />
+                </button>
+            </div>
+        </header>
+    )
+}
