diff --git a/src/components/Button/index.tsx b/src/components/Button/index.tsx
index 5a397b60..445e9b24 100644
--- a/src/components/Button/index.tsx
+++ b/src/components/Button/index.tsx
@@ -19,6 +19,8 @@ interface ButtonProps extends BaseComponentProps {
     title?: string
     ariaLabel?: string
     pressed?: boolean
+    // shows the Windows UAC shield: the action asks for administrator approval
+    shield?: boolean
     onClick?: MouseEventHandler<HTMLButtonElement>
     disabled?: boolean
 }
@@ -33,6 +35,7 @@ export function Button (props: ButtonProps) {
         title,
         ariaLabel,
         pressed,
+        shield = false,
         onClick = noop,
         children,
         className,
@@ -63,6 +66,7 @@ export function Button (props: ButtonProps) {
             aria-pressed={pressed}
             aria-busy={loading || undefined}
         >
+            {shield && !loading && <UacShield />}
             {loading && !busyIcon
                 ? <span className="button-spinner" aria-hidden="true" />
                 : icon && <Icon type={icon} size={size === 'sm' ? 14 : 16} className={classnames({ 'is-busy': busyIcon })} />}
@@ -70,3 +74,14 @@ export function Button (props: ButtonProps) {
         </button>
     )
 }
+
+// The four-colour UAC shield Windows puts on elevation buttons.
+function UacShield () {
+    return (
+        <svg className="button-shield" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
+            <path d="M8 1.2 2.6 3.3v4.2c0 3.3 2.3 6 5.4 7.3 3.1-1.3 5.4-4 5.4-7.3V3.3z" fill="#1e6fd9" />
+            <path d="M8 1.2v13.6c3.1-1.3 5.4-4 5.4-7.3V3.3z" fill="#f2c12e" />
+            <path d="M8 1.2 2.6 3.3V8H8zM8 8v6.8c3.1-1.3 5.4-4 5.4-7.3V8z" fill="#2b88f0" opacity=".55" />
+        </svg>
+    )
+}
diff --git a/src/components/Button/style.css b/src/components/Button/style.css
index 603dac31..5e3f505e 100644
--- a/src/components/Button/style.css
+++ b/src/components/Button/style.css
@@ -1,9 +1,17 @@
+/*
+ * WinUI Button family.
+ * normal  → Button (control fill, elevation border: darker bottom edge in light, lighter top edge in dark)
+ * primary → AccentButton
+ * ghost   → SubtleButton (no fill until hover)
+ * danger / success / warning → standard button with a semantic text colour
+ * Pressed state dims content instead of scaling, as Windows controls do.
+ */
 .button {
-    --btn-bg: var(--panel);
+    --btn-bg: var(--ctl);
     --btn-fg: var(--text);
-    --btn-border: var(--hair-2);
-    --btn-hover: var(--panel);
-    --btn-hover-border: color-mix(in srgb, var(--accent) 45%, transparent);
