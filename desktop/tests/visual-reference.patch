+++ b/src/containers/Shell/nav-mode.ts
@@ -0,0 +1,53 @@
+import { useEffect, useState } from 'react'
+
+// NavigationView PaneDisplayMode="Auto": expanded at 1008px and wider,
+// a compact icon rail from 641px, and a hidden pane behind the hamburger below that.
+export type NavMode = 'expanded' | 'compact' | 'minimal'
+const KEY = 'navCollapsed'
+
+function readCollapsed () {
+    try { return localStorage.getItem(KEY) === 'true' } catch { return false }
+}
+
+function modeFor (width: number, collapsed: boolean): NavMode {
+    if (width >= 1008) return collapsed ? 'compact' : 'expanded'
+    if (width >= 641) return 'compact'
+    return 'minimal'
+}
+
+export function useNavMode () {
+    const [collapsed, setCollapsed] = useState(readCollapsed)
+    const [width, setWidth] = useState(() => window.innerWidth)
+    const [open, setOpen] = useState(false)
+    // The pane animates only when the user toggles it. A window resize changes
+    // the display mode at once, as NavigationView does.
+    const [animating, setAnimating] = useState(false)
+    useEffect(() => {
+        if (!animating) return
+        const timer = window.setTimeout(() => setAnimating(false), 320)
+        return () => window.clearTimeout(timer)
+    }, [animating])
+
+    useEffect(() => {
+        function resize () { setWidth(window.innerWidth) }
+        window.addEventListener('resize', resize)
+        return () => window.removeEventListener('resize', resize)
+    }, [])
+
+    const mode = modeFor(width, collapsed)
+    useEffect(() => { setOpen(false) }, [mode])
+
+    function toggle () {
+        setAnimating(true)
+        if (width >= 1008) {
+            const next = !collapsed
+            setCollapsed(next)
+            try { localStorage.setItem(KEY, String(next)) } catch { /* preference only */ }
+            setOpen(false)
+            return
+        }
+        setOpen(value => !value)
+    }
+
+    return { mode, open, animating, toggle, close: () => { setAnimating(true); setOpen(false) } }
+}
