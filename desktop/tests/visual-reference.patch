@@ -0,0 +1,127 @@
+/* Drill-in sub-page: covers the content layer, keeps its rounded corner. */
+.subpage {
+    position: fixed;
+    z-index: var(--z-modal);
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+    overflow: hidden;
+    border-top: 1px solid var(--layer-stroke);
+    border-left: 1px solid var(--layer-stroke);
+    border-top-left-radius: var(--r-overlay);
+    background: var(--solid-base);
+    transform-origin: 50% 30%;
+}
+
+.subpage.is-closed {
+    visibility: hidden;
+    pointer-events: none;
+    /* Hidden once the short exit fade has run. */
+    transition: visibility 0s linear 90ms;
+}
+
+.subpage::before {
+    content: '';
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    background: var(--layer);
+}
+
+.nav-minimal .subpage,
+.subpage.is-full {
+    border-left: 0;
+    border-top-left-radius: 0;
+}
+
+.subpage-header {
+    display: flex;
+    flex: none;
+    align-items: center;
+    gap: 8px;
+    min-width: 0;
+    padding: 20px clamp(16px, 3vw, 36px) 12px clamp(8px, 2vw, 28px);
+}
+
+.subpage-crumbs {
+    display: flex;
+    flex: 1 1 auto;
+    align-items: center;
+    gap: 8px;
+    min-width: 0;
+}
+
+.subpage-crumb {
+    flex: none;
+    padding: 0 2px;
+    border-radius: var(--r-ctl);
+    color: var(--text-2);
+    font-family: var(--font-display);
+    font-size: var(--t-2xl);
+    font-weight: 600;
+    line-height: 36px;
+    cursor: default;
+    transition: color var(--dur-1) linear;
+}
+
+.subpage-crumb:hover {
+    color: var(--text);
+}
+
+.subpage-crumb-sep {
+    flex: none;
+    color: var(--text-2);
+}
+
+.subpage-title {
+    min-width: 0;
+    margin: 0;
+    overflow: hidden;
+    font-family: var(--font-display);
+    font-size: var(--t-2xl);
+    font-weight: 600;
+    line-height: 36px;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.subpage-aside {
+    display: flex;
+    flex: none;
+    align-items: center;
+    gap: 8px;
+}
+
+.subpage-body {
+    display: flex;
+    flex: 1 1 auto;
+    flex-direction: column;
+    min-height: 0;
+    padding: 0 clamp(16px, 3vw, 36px) 20px;
+    overflow: auto;
+}
+
+@media (max-width: 768px), (max-height: 500px) and (pointer: coarse) {
+    .subpage {
+        border: 0;
+        border-radius: 0;
+    }
+
+    .subpage-header {
+        padding: calc(8px + env(safe-area-inset-top)) 12px 8px 4px;
+    }
+
+    .subpage-crumb,
+    .subpage-crumb-sep {
+        display: none;
+    }
+
+    .subpage-title {
+        font-size: var(--t-xl);
+        line-height: 28px;
+    }
+
+    .subpage-body {
+        padding: 0 calc(12px + env(safe-area-inset-right)) calc(12px + env(safe-area-inset-bottom)) calc(12px + env(safe-area-inset-left));
+    }
+}
