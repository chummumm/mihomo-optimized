diff --git a/src/platform/TrayFlyout.tsx b/src/platform/TrayFlyout.tsx
new file mode 100644
index 00000000..c102b76b
--- /dev/null
+++ b/src/platform/TrayFlyout.tsx
@@ -0,0 +1,185 @@
+import classnames from 'classnames'
+import { useAtomValue } from 'jotai'
+import { useEffect, useMemo } from 'react'
+
+import logo from '@assets/logo.png'
+import { ButtonSelect, Icon, ProgressRing, Sparkline, StaticBytes, delayStatus, error as toastError } from '@components'
+import { useConnections } from '@containers/Connections/store'
+import { resolveProxyExit } from '@containers/Proxies/resolve'
+import { refreshDesktopAppearance } from '@containers/Shell/appearance'
+import { proxyGroupMapping, proxyMapping, useClient, useConnectionStreamReader, useGeneral, useI18n, useProxy } from '@stores'
+
+import { desktopAction, desktopInvoke, useDesktop } from './desktop'
+import { desktopError } from './model'
+import './tray.css'
+
+function run (command: string, args?: Record<string, unknown>) {
+    void desktopAction(command, args).catch(reason => { toastError(desktopError(reason).message) })
+}
+
+// Steps that need the full window (UAC explanation, a page) continue there.
+function openMain (request?: string) {
+    void desktopInvoke('desktop_show_main', request ? { request } : {}).catch(() => undefined)
+}
+
+async function hideSelf () {
+    try {
+        const { getCurrentWindow } = await import('@tauri-apps/api/window')
+        await getCurrentWindow().hide()
+    } catch { /* the host hides it on blur anyway */ }
+}
+
+/**
+ * The tray flyout, laid out like Windows quick settings: status and identity,
+ * outbound mode, quick toggles, where traffic goes, then live rates and power.
+ */
+export function TrayFlyout () {
+    const desktop = useDesktop()
+    const { translation } = useI18n()
+    const { t } = translation('Tray')
+    const { t: shell } = translation('Shell')
+    const client = useClient()
+    const { general, update: refreshGeneral } = useGeneral()
+    const { groups } = useProxy()
+    const groupMap = useAtomValue(proxyGroupMapping)
+    const nodes = useAtomValue(proxyMapping)
+    const status = desktop.status
+    const phase = status?.phase ?? (desktop.ready ? 'error' : 'starting')
+    const running = phase === 'running'
+    const busy = !!desktop.busy || phase === 'starting' || phase === 'stopping'
+    const reader = useConnectionStreamReader(running && desktop.visible)
+    const { rate, samples } = useConnections(reader)
+
+    useEffect(() => {
+        document.documentElement.classList.add('is-tray')
+        void refreshDesktopAppearance()
+        function keydown (event: KeyboardEvent) {
+            if (event.key === 'Escape') void hideSelf()
+        }
+        window.addEventListener('keydown', keydown)
+        return () => window.removeEventListener('keydown', keydown)
+    }, [])
+
+    // Re-read the runtime settings each time the flyout opens.
+    useEffect(() => {
+        if (desktop.visible && running) void refreshGeneral()
+    }, [desktop.visible, running, refreshGeneral])
+
+    const trace = useMemo(() => samples.slice(-40).map(sample => sample.down), [samples])
+    const exits = groups.filter(group => group.type === 'Selector' || group.type === 'URLTest' || group.type === 'Fallback').slice(0, 3)
+
+    async function setMode (mode: string) {
+        try {
+            await client.updateConfig({ mode })
+            await refreshGeneral()
+        } catch (reason) { toastError(desktopError(reason).message) }
+    }
+
+    async function toggleLan () {
+        try {
+            await client.updateConfig({ 'allow-lan': !general.allowLan })
+            await refreshGeneral()
+        } catch (reason) { toastError(desktopError(reason).message) }
+    }
+
+    function toggleTun () {
+        if (!status) return
+        if (!status.tun && !status.service?.installed) { openMain('tun'); return }
+        run('desktop_set_tun', { enabled: !status.tun })
+    }
+
+    const state = shell(`core.${phase === 'error' && !status ? 'offline' : phase}` as 'core.running')
+    const sub = running && general.mode ? `${state} · ${shell(`modes.${general.mode}` as 'modes.rule')}` : state
+
+    const tiles = [
+        { key: 'proxy', icon: 'nav-proxies', label: t('systemProxy'), on: !!status?.systemProxy, disabled: busy || !status?.capabilities.systemProxy, onClick: () => run('desktop_set_system_proxy', { enabled: !status?.systemProxy }) },
+        { key: 'tun', icon: 'shield-lock', label: t('tun'), on: !!status?.tun, disabled: busy || !status?.capabilities.tun, onClick: toggleTun },
+        { key: 'lan', icon: 'wifi', label: t('lan'), on: !!general.allowLan, disabled: !running, onClick: () => { void toggleLan() } },
+    ]
+
+    return (
+        <main className="tray-flyout" aria-label={t('flyout')} data-phase={phase}>
+            <header className="tray-head">
+                <img className="tray-logo" src={logo} alt="" />
+                <div className="tray-identity">
+                    <b>Mihomo Optimized</b>
+                    <span className="tray-state"><i aria-hidden="true" />{sub}</span>
+                </div>
+                <button type="button" className="tray-icon-button" aria-label={t('settings')} title={t('settings')} onClick={() => openMain('route:/settings')}>
+                    <Icon type="setting" size={16} />
+                </button>
+                <button type="button" className="tray-icon-button" aria-label={t('openMain')} title={t('openMain')} onClick={() => openMain()}>
+                    <Icon type="window-new" size={16} />
+                </button>
+            </header>
+
+            <div className="tray-body">
+                <ButtonSelect
+                    className="tray-mode"
+                    label={shell('commands.currentMode')}
+                    disabled={!running}
+                    value={general.mode}
+                    options={[
+                        { label: shell('modeShort.rule'), value: 'rule' },
+                        { label: shell('modeShort.global'), value: 'global' },
+                        { label: shell('modeShort.direct'), value: 'direct' },
+                    ]}
+                    onSelect={value => { void setMode(value) }} />
+
+                <div className="tray-tiles">
+                    {tiles.map(tile => (
+                        <div key={tile.key} className="tray-tile">
+                            <button type="button" className={classnames('tray-tile-button', { 'is-on': tile.on })} aria-pressed={tile.on} aria-label={tile.label} disabled={tile.disabled} onClick={tile.onClick}>
+                                <Icon type={tile.icon} size={16} filled={tile.on} />
+                            </button>
+                            <span className="tray-tile-label">{tile.label}</span>
+                        </div>
+                    ))}
+                </div>
+
+                {running
+                    ? <section className="tray-exits" aria-label={t('exits')}>
+                        {exits.length === 0 && <p className="tray-note">{t('noGroups')}</p>}
+                        {exits.map(group => {
+                            const exit = resolveProxyExit(group.now, groupMap)
+                            const delay = exit ? nodes.get(exit)?.history?.slice(-1)[0]?.delay ?? 0 : 0
+                            return (
+                                <button key={group.name} type="button" className="tray-exit" onClick={() => openMain(`group:${group.name}`)}>
+                                    <span className="tray-exit-icon"><Icon type={group.type === 'Selector' ? 'nav-proxies' : 'top-speed'} size={16} /></span>
+                                    <span className="tray-exit-text">
+                                        <b>{group.name}</b>
+                                        <span>{exit ?? '—'}{delay > 0 ? ` · ${delay} ms` : ''}</span>
+                                    </span>
+                                    <i className={classnames('tray-dot', `is-${delayStatus(delay)}`)} aria-hidden="true" />
+                                    <Icon type="chevron-right" size={12} className="tray-chevron" />
+                                </button>
+                            )
+                        })}
+                    </section>
+                    : <section className="tray-stopped">
+                        <span className="tray-stopped-glyph">{busy ? <ProgressRing size={28} /> : <Icon type="plug-disconnected" size={24} />}</span>
+                        <b>{busy ? state : t('stoppedTitle')}</b>
+                        <span>{status?.lastError || t('stoppedHint')}</span>
+                    </section>}
+            </div>
+
+            <footer className="tray-foot">
+                <div className="tray-rates">
+                    <span><Icon type="arrow-down" size={12} /><StaticBytes value={running ? rate.down : 0} rate /></span>
+                    <span><Icon type="arrow-up" size={12} /><StaticBytes value={running ? rate.up : 0} rate /></span>
+                </div>
+                <Sparkline className="tray-spark" values={trace.length > 1 ? trace : [0, 0]} height={28} />
+                <button
+                    type="button"
+                    className={classnames('tray-power', { 'is-on': running })}
+                    aria-label={running ? t('stop') : t('start')}
+                    title={running ? t('stop') : t('start')}
+                    disabled={busy || !status}
+                    onClick={() => run(running ? 'desktop_stop' : 'desktop_start')}
+                >
+                    {busy ? <ProgressRing size={16} /> : <Icon type="power" size={16} />}
+                </button>
+            </footer>
+        </main>
+    )
+}
