+.profile-current {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+    padding: 20px 24px;
+}
+
+.profile-current-main {
+    display: flex;
+    align-items: center;
+    gap: 16px;
+    min-width: 0;
+}
+
+.profile-file-icon {
+    display: grid;
+    flex: none;
+    place-items: center;
+    width: 48px;
+    height: 48px;
+    border-radius: var(--r-panel);
+    background: var(--ctl-alt);
+    color: var(--accent-text);
+}
+
+.profile-current-text {
+    display: flex;
+    flex: 1 1 auto;
+    flex-direction: column;
+    min-width: 0;
+}
+
+.profile-current-label {
+    color: var(--text-2);
+    font-size: var(--t-xs);
+    line-height: 16px;
+}
+
+.profile-current-name {
+    overflow: hidden;
+    font-family: var(--font-display);
+    font-size: var(--t-lg);
+    font-weight: 600;
+    line-height: 24px;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.profile-current-path {
+    overflow: hidden;
+    color: var(--text-3);
+    font-family: var(--font-mono);
+    font-size: var(--t-xs);
+    line-height: 16px;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.profile-current-counts {
+    flex: none;
+    padding: 2px 8px;
+    border-radius: var(--r-chip);
+    background: var(--ctl-alt);
+    color: var(--text-2);
+    font-size: var(--t-xs);
+}
+
+.profile-current-actions {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 8px;
+}
+
+.profile-more {
+    width: 32px;
+    padding: 0;
+}
+
+.profile-note {
+    margin: 0;
+    color: var(--text-3);
+    font-size: var(--t-xs);
+}
+
+.profile-url {
+    display: flex;
+    gap: 8px;
+    width: 100%;
+}
+
+.profile-url-input {
+    flex: 1 1 auto;
+    min-width: 0;
+}
+
+@container content (max-width: 560px) {
+    .profile-current {
+        padding: 16px;
+    }
+
+    .profile-current-counts {
+        display: none;
+    }
+}
+
+/* The section heading already names the resources card. */
+#set-resources .settings-update > .settings-row:first-child:not(.settings-update-row, .settings-row-action) {
+    display: none;
+}
