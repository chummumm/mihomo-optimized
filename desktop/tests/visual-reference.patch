--- /dev/null
+++ b/src/containers/Shell/appearance.ts
@@ -0,0 +1,83 @@
+import { useSyncExternalStore } from 'react'
+
+import { desktopInvoke, isDesktop } from '../../platform/desktop'
+
+// Theme preference: follow Windows by default; an explicit choice sets
+// html[data-theme]. On the desktop the native window theme follows too, so
+// Mica and the caption area tint the same way as the page.
+
+export type ThemePreference = 'system' | 'light' | 'dark'
+const KEY = 'theme'
+const listeners = new Set<() => void>()
+
+function read (): ThemePreference {
+    try {
+        const value = localStorage.getItem(KEY)
+        return value === 'light' || value === 'dark' ? value : 'system'
+    } catch { return 'system' }
+}
+
+let preference: ThemePreference = read()
+
+export function applyTheme (value: ThemePreference = preference) {
+    const root = document.documentElement
+    if (value === 'system') root.removeAttribute('data-theme')
+    else root.setAttribute('data-theme', value)
+    if (isDesktop()) {
+        void import('@tauri-apps/api/window')
+            .then(({ getCurrentWindow }) => getCurrentWindow().setTheme(value === 'system' ? null : value))
+            .catch(() => undefined)
+    }
+}
+
+export function setThemePreference (value: ThemePreference) {
+    preference = value
+    try {
+        if (value === 'system') localStorage.removeItem(KEY)
+        else localStorage.setItem(KEY, value)
+    } catch { /* storage may be unavailable; the choice still applies to this session */ }
+    applyTheme(value)
+    for (const listener of listeners) listener()
+}
+
+export function useThemePreference () {
+    return useSyncExternalStore(
+        listener => { listeners.add(listener); return () => listeners.delete(listener) },
+        () => preference,
+        () => preference,
+    )
+}
+
+interface DesktopAppearance {
+    mica: boolean
+    // Windows accent palette: light-theme fill, dark-theme fill, and their text colours.
+    accent: { light: string, dark: string, lightText: string, darkText: string } | null
+}
+
+const HEX = /^#[0-9a-f]{6}$/i
+
+// Reads the Windows accent palette and whether DWM is drawing Mica behind the
+// window. Without Mica (Windows 10) the page keeps painting its own solid ground.
+export async function refreshDesktopAppearance () {
+    if (!isDesktop()) return
+    try {
+        const value = await desktopInvoke<DesktopAppearance>('desktop_appearance')
+        const root = document.documentElement
+        root.classList.toggle('is-mica', value.mica)
+        const accent = value.accent
+        if (accent && [accent.light, accent.dark, accent.lightText, accent.darkText].every(color => HEX.test(color))) {
+            root.style.setProperty('--acc-l', accent.light)
+            root.style.setProperty('--acc-d', accent.dark)
+            root.style.setProperty('--acc-tl', accent.lightText)
+            root.style.setProperty('--acc-td', accent.darkText)
+        }
+    } catch { /* older hosts: keep the default blue and a solid ground */ }
+}
+
+export function initializeAppearance () {
+    applyTheme()
+    if (!isDesktop()) return
+    void refreshDesktopAppearance()
+    // The accent can change while the app runs; re-read it when the window comes back.
+    window.addEventListener('focus', () => { void refreshDesktopAppearance() })
+}
diff --git a/src/containers/Shell/nav-mode.ts b/src/containers/Shell/nav-mode.ts
