@@ -0,0 +1,98 @@
+.menu-flyout {
+    position: fixed;
+    z-index: var(--z-popover);
+    min-width: 200px;
+    max-width: min(360px, calc(100vw - 16px));
+    padding: 4px;
+    border: 1px solid var(--acrylic-stroke);
+    border-radius: var(--r-overlay);
+    background: var(--acrylic);
+    background-clip: padding-box;
+    box-shadow: var(--shadow-flyout);
+    -webkit-backdrop-filter: blur(30px) saturate(1.5);
+    backdrop-filter: blur(30px) saturate(1.5);
+    animation: menu-down var(--dur-3) var(--ease-out);
+}
+
+.menu-flyout-up { animation-name: menu-up; }
+.menu-flyout-right { animation-name: menu-right; }
+
+@keyframes menu-down { from { opacity: 0; transform: translateY(-12px); } }
+@keyframes menu-up { from { opacity: 0; transform: translateY(12px); } }
+@keyframes menu-right { from { opacity: 0; transform: translateX(-12px); } }
+
+.menu-item {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    width: 100%;
+    min-height: 32px;
+    padding: 0 11px;
+    border-radius: var(--r-ctl);
+    color: var(--text);
+    font-size: var(--t-md);
+    text-align: left;
+    white-space: nowrap;
+    cursor: default;
+}
+
+.menu-item + .menu-item {
+    margin-top: 2px;
+}
+
+.menu-item:hover:not(:disabled),
+.menu-item:focus-visible {
+    background: var(--subtle-hover);
+    outline: none;
+    box-shadow: none;
+}
+
+.menu-item:active:not(:disabled) {
+    background: var(--subtle-press);
+    color: var(--text-2);
+}
+
+.menu-item:disabled {
+    color: var(--text-dis);
+}
+
+.menu-lead {
+    display: inline-grid;
+    flex: none;
+    place-items: center;
+    width: 16px;
+    height: 16px;
+}
+
+.menu-dot {
+    width: 6px;
+    height: 6px;
+    border-radius: 50%;
+    background: currentColor;
+}
+
+.menu-label {
+    flex: 1;
+    min-width: 0;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.menu-accelerator {
+    padding-left: 24px;
+    color: var(--text-3);
+    font-size: var(--t-xs);
+}
+
+.menu-separator {
+    height: 1px;
+    margin: 4px -4px;
+    background: var(--divider);
+}
+
+.menu-header {
+    padding: 8px 11px 4px;
+    color: var(--text-2);
+    font-size: var(--t-xs);
+    font-weight: 600;
+}
