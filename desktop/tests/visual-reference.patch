diff --git a/src/containers/Settings/focus-target.ts b/src/containers/Settings/focus-target.ts
new file mode 100644
index 00000000..1872f49e
--- /dev/null
+++ b/src/containers/Settings/focus-target.ts
@@ -0,0 +1,24 @@
+import { useEffect } from 'react'
+import { useLocation } from 'react-router-dom'
+
+// Search and other pages can send the user to one control: scroll it into the
+// middle of the view and flash it twice so the eye finds it.
+export function useFocusTarget () {
+    const location = useLocation()
+    const target = (location.state as { focus?: string } | null)?.focus
+    useEffect(() => {
+        if (!target) return
+        const frame = requestAnimationFrame(() => {
+            const element = document.getElementById(target)
+            if (!element) return
+            const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
+            element.scrollIntoView({ block: 'center', behavior: still ? 'auto' : 'smooth' })
+            element.classList.remove('attention')
+            void element.offsetWidth
+            element.classList.add('attention')
+            element.focus({ preventScroll: true })
+            window.setTimeout(() => element.classList.remove('attention'), 3000)
+        })
+        return () => cancelAnimationFrame(frame)
+    }, [target, location.key])
+}
