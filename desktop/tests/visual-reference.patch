+                        <MenuFlyout open={moreOpen} anchor={moreButton} placement="bottom-end" label={t('more')} items={moreItems} onClose={() => setMoreOpen(false)} />
+                    </>}
+                </div>
+                {!isDesktop && <p className="profile-note">{t('controllerNote')}</p>}
+            </Card>
+
+            <section className="settings-section">
+                <div className="settings-section-head">
+                    <h2 className="settings-section-title">{t('importSection')}</h2>
+                    {isDesktop && <span className="settings-section-aside">{t('importAside')}</span>}
+                </div>
