 }
 
 .alert-icon {
@@ -17,13 +19,13 @@
 
 .alert-message {
     min-width: 0;
-    max-width: 68ch;
+    max-width: 80ch;
 }
 
 .alert-info .alert-icon { color: var(--accent); }
