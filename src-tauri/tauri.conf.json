{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mihomo Optimized",
  "version": "0.1.1",
  "identifier": "com.chummumm.mihomo-optimized",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:desktop",
    "beforeDevCommand": "pnpm start:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mihomo Optimized",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/mihomo-core", "binaries/mihomo-desktop-service", "binaries/mihomo-update-verify"],
    "resources": ["resources/trusted-root.jsonl", "resources/build-info.json", "resources/licenses/"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper"},
      "nsis": {"installMode": "perMachine", "displayLanguageSelector": false, "languages": ["SimpChinese", "English"], "installerHooks": "windows/hooks.nsh"}
    }
  }
}
